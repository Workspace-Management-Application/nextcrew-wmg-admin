<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Admin Dashboard - Workspace Management" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Google Fonts - Catamaran and Mukta -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Catamaran:wght@300;400;500;600;700&family=Mukta:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Custom Font Styling -->
    <style>
      /* Apply Catamaran to body and normal text */
      body, .admin-body {
        font-family: 'Catamaran', sans-serif !important;
      }
      
      /* Apply Mukta to headings */
      h1, h2, h3, h4, h5, h6, .sidebar-title {
        font-family: 'Mukta', sans-serif !important;
      }
      
      /* Special styling for NEXTCOWORKS branding */
      .brand-heading {
        font-family: 'Mukta', sans-serif !important;
        font-weight: 700;
        letter-spacing: 3px;
      }
      
      /* Apply Catamaran to sidebar nav items and other text */
      .nav-text, .nav-item, p, span, div, td, th, .btn, .dropdown-item {
        font-family: 'Catamaran', sans-serif;
      }
      
      /* Dark theme pagination styling */
      .pagination {
        --bs-pagination-bg: #2d2d2d;
        --bs-pagination-border-color: #555;
        --bs-pagination-color: #fff;
        --bs-pagination-hover-bg: #404040;
        --bs-pagination-hover-border-color: #666;
        --bs-pagination-hover-color: #fff;
        --bs-pagination-active-bg: #007bff;
        --bs-pagination-active-border-color: #007bff;
        --bs-pagination-active-color: #fff;
        --bs-pagination-disabled-bg: #1a1a1a;
        --bs-pagination-disabled-border-color: #333;
        --bs-pagination-disabled-color: #666;
      }
      
      .pagination .page-link {
        background-color: var(--bs-pagination-bg);
        border-color: var(--bs-pagination-border-color);
        color: var(--bs-pagination-color);
      }
      
      .pagination .page-link:hover {
        background-color: var(--bs-pagination-hover-bg);
        border-color: var(--bs-pagination-hover-border-color);
        color: var(--bs-pagination-hover-color);
      }
      
      .pagination .page-item.active .page-link {
        background-color: var(--bs-pagination-active-bg);
        border-color: var(--bs-pagination-active-border-color);
        color: var(--bs-pagination-active-color);
      }
      
      .pagination .page-item.disabled .page-link {
        background-color: var(--bs-pagination-disabled-bg);
        border-color: var(--bs-pagination-disabled-border-color);
        color: var(--bs-pagination-disabled-color);
      }
      
      /* Clickable row styling */
      .clickable-row:hover {
        background-color: #404040 !important;
      }
      
      .action-column {
        pointer-events: all;
      }
      
      /* Fix sidebar header alignment */
      .sidebar-header {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        padding: 1rem;
        min-height: 60px;
      }
      
      .sidebar-title {
        margin-bottom: 0 !important;
        line-height: 1.5;
        display: flex !important;
        align-items: center !important;
      }
      
      .sidebar-toggle {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 0 !important;
        width: 38px !important;
        height: 38px !important;
        line-height: 1 !important;
        border: 1px solid rgba(255,255,255,0.3) !important;
      }
      
      /* Profile dropdown responsive positioning */
      .profile-dropdown {
        position: relative;
      }
      
      .profile-dropdown .dropdown-menu {
        position: absolute;
        top: 100%;
        min-width: 200px;
        z-index: 1050;
        margin-top: 0.125rem;
        /* Remove default positioning - let JavaScript handle it dynamically */
      }
      
      @media (max-width: 576px) {
        .profile-dropdown {
          position: static;
        }
        
        .profile-dropdown .dropdown-menu {
          position: fixed;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          width: 90%;
          max-width: 300px;
          z-index: 1060;
        }
      }
    </style>
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <%= stylesheet_link_tag 'application', 'data-turbo-track': 'reload' %>
    <%= javascript_importmap_tags %>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    
    <!-- Select2 Dark Theme Styling -->
    <style>
      .select2-container {
        width: 100% !important;
      }
      
      .select2-container--default .select2-selection--single {
        background-color: #1a1a1a !important;
        border: 1px solid #333333 !important;
        color: #ffffff !important;
        border-radius: 6px !important;
        min-height: 38px;
        box-shadow: none !important;
        padding: 0.375rem 0.75rem;
        cursor: pointer !important;
      }
      
      .select2-container--default .select2-selection--multiple {
        background-color: #1a1a1a !important;
        border: 1px solid #333333 !important;
        color: #ffffff !important;
        border-radius: 6px !important;
        min-height: 38px;
        box-shadow: none !important;
        padding: 0.375rem 0.75rem;
        cursor: pointer !important;
      }
      
      .select2-container--default .select2-selection--single:focus,
      .select2-container--default .select2-selection--multiple:focus,
      .select2-container--default.select2-container--open .select2-selection--single,
      .select2-container--default.select2-container--open .select2-selection--multiple {
        border-color: #ffffff !important;
        box-shadow: 0 0 0 0.2rem rgba(255,255,255,0.1) !important;
        color: #ffffff !important;
        outline: none !important;
        background-color: #1a1a1a !important;
      }
      
      .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: #ffffff !important;
        line-height: 1.5;
      }
      
      .select2-container--default .select2-selection--multiple .select2-selection__choice {
        background-color: #333333 !important;
        border: 1px solid #555555 !important;
        color: #ffffff !important;
        border-radius: 4px;
        padding: 2px 8px;
        margin: 2px;
      }
      
      .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
        color: #ffffff !important;
        margin-right: 5px;
      }
      
      .select2-container--default .select2-selection--multiple .select2-selection__choice__remove:hover {
        color: #ff6b6b !important;
      }
      
      .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 100%;
        top: 0;
        right: 10px;
      }
      
      .select2-container--default .select2-selection--single .select2-selection__arrow b {
        border-color: #ffffff transparent transparent transparent !important;
      }
      
      .select2-container--default.select2-container--open .select2-selection--single .select2-selection__arrow b {
        border-color: transparent transparent #ffffff transparent !important;
      }
      
      .select2-dropdown {
        background-color: #222 !important;
        border: 1px solid #333333 !important;
        border-radius: 6px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
      }
      
      .select2-container--default .select2-search--dropdown .select2-search__field {
        background-color: #1a1a1a !important;
        border: 1px solid #333333 !important;
        color: #ffffff !important;
        border-radius: 4px;
        padding: 8px;
      }
      
      .select2-container--default .select2-search--dropdown .select2-search__field:focus {
        background-color: #1a1a1a !important;
        border-color: #ffffff !important;
        color: #ffffff !important;
        box-shadow: 0 0 0 0.2rem rgba(255,255,255,0.1) !important;
        outline: none;
      }
      
      .select2-container--default .select2-results__option {
        color: #ffffff !important;
        padding: 8px 12px;
      }
      
      .select2-container--default .select2-results__option--highlighted[aria-selected] {
        background-color: #444 !important;
        color: #ffffff !important;
      }
      
      .select2-container--default .select2-results__option[aria-selected=true] {
        background-color: #333333 !important;
        color: #ffffff !important;
      }
      
      .select2-container--default .select2-results__option--highlighted[aria-selected=true] {
        background-color: #444 !important;
        color: #ffffff !important;
      }
      
      .select2-container--default .select2-selection--single .select2-selection__placeholder {
        color: #666666 !important;
      }
    </style>
  </head>

  <body class="admin-body">
    <!-- Sidebar -->
    <div class="sidebar show" id="sidebar">
            <div class="sidebar-header d-flex align-items-center gap-2">
        <h4 class="sidebar-title mb-0 d-flex align-items-center" style="font-size: 1.25rem;"><%= format_role_display(current_user.role) %> Panel</h4>
        <button class="sidebar-toggle btn btn-outline-light" onclick="toggleSidebar()" style="width: 32px; height: 32px; padding: 0; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">
          ☰
        </button>
      </div>
      
      <nav class="sidebar-nav">
        <% sidebar_links = [
          { key: "dashboard", label: "Dashboard", icon: "📊", path: admin_dashboard_path, active: current_page?(admin_dashboard_path) },
          { key: "workspaces", label: "Workspaces", icon: "🏢", path: admin_workspaces_path, active: controller_name == "workspaces" },
          { key: "rooms", label: "Rooms", icon: "🚪", path: admin_rooms_path, active: controller_name == "rooms" },
          { key: "bookings", label: "Bookings", icon: "📅", path: admin_bookings_path, active: controller_name == "bookings" },
          { key: "users", label: "Users", icon: "👤", path: admin_users_path, active: controller_name == "users" },
          { key: "companies", label: "Companies", icon: "🏭", path: admin_companies_path, active: controller_name == "companies" },
          { key: "office_enquiries", label: "Office Enquiries", icon: "📋", path: admin_office_enquiries_path, active: controller_name == "office_enquiries" },
          { key: "visitor_entries", label: "Visitor Entries", icon: "👥", path: admin_visitor_entries_path, active: controller_name == "visitor_entries" },
          { key: "day_passes", label: "Day Passes", icon: "🎫", path: admin_day_passes_path, active: controller_name == "day_passes" },
          { key: "workspace_types", label: "Workspace Types", icon: "⚙️", path: admin_workspace_types_path, active: controller_name == "workspace_types" },
          { key: "amenities", label: "Amenities", icon: "🛠️", path: admin_amenities_path, active: controller_name == "amenities" },
          { key: "exports", label: "Export", icon: "📊", path: admin_exports_path, active: controller_name == "exports", data: { turbo: false } }
        ] %>

        <% sidebar_links.each do |item| %>
          <% next unless current_user.sidebar_item_visible?(item[:key]) %>
          <%= link_to item[:path], class: "nav-item #{'active' if item[:active]}", data: item[:data] do %>
            <span class="nav-icon"><%= item[:icon] %></span>
            <span class="nav-text"><%= item[:label] %></span>
          <% end %>
        <% end %>
      </nav>
    </div>

    <!-- Floating open sidebar button -->
    <button id="openSidebarBtn" class="btn btn-outline-light position-fixed" style="top: 20px; left: 10px; z-index: 2000; display: none; font-size: 1.5rem;" onclick="toggleSidebar()">
      ☰
    </button>

    <!-- Main Content -->
    <div class="main-content">
      <!-- Top Header -->
      <header class="top-header d-flex align-items-center" style="min-height: 120px; background: #000 !important; color: #fff !important; position: relative;">
        <div class="flex-grow-1 text-center">
          <img src="https://meetingroombookingbucket.s3.amazonaws.com/New-Project.png" alt="NextCoworks Logo" style="max-height: 60px; margin-bottom: 0.5rem;">
          <hr style="width: 60px; margin: 0.5rem auto; border-top: 2px solid #fff; opacity: 1;">
          <div style="font-family: 'Catamaran', sans-serif; font-size: 1rem;">Coworking Spaces | Private Cabin | Private Office | Private Desk | Shared Desk</div>
        </div>
        <!-- Profile Dropdown -->
        <div class="profile-dropdown position-absolute end-0 me-4">
          <button class="profile-btn" id="profileDropdownBtn" type="button">
            <div class="profile-avatar">
              <%= current_user.name&.first&.upcase || "A" %>
            </div>
          </button>
          <ul class="dropdown-menu" id="profileDropdownMenu">
            <li><%= link_to "Edit Profile", admin_profile_path, class: "dropdown-item" %></li>
            <li><hr class="dropdown-divider"></li>
            <li><%= button_to "Logout", destroy_user_session_path, method: :delete, class: "dropdown-item border-0 bg-transparent w-100 text-start", form: { style: "display: inline;" } %></li>
          </ul>
        </div>
      </header>

      <!-- Content Area -->
      <main class="content-area">
        <% if notice %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= notice %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>

        <% if alert %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= alert %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>

        <%= yield %>
      </main>
    </div>

    <%= yield :scripts %>
    
    <!-- jQuery (required for Select2) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
      function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        sidebar.classList.toggle('show');
      }

      // Initialize Bootstrap components
      function initializeBootstrapComponents() {
        // Make sure Bootstrap is available
        if (typeof bootstrap === 'undefined') {
          console.warn('Bootstrap not loaded yet, retrying in 100ms...');
          setTimeout(initializeBootstrapComponents, 100);
          return;
        }

        // Initialize all dropdowns except the profile dropdown
        const dropdownElementList = document.querySelectorAll('[data-bs-toggle="dropdown"]');
        dropdownElementList.forEach(function(dropdownToggleEl) {
          // Skip the profile dropdown as it's handled separately
          if (dropdownToggleEl.id === 'profileDropdownBtn') {
            return;
          }
          
          try {
            // Remove any existing dropdown instance
            const existingDropdown = bootstrap.Dropdown.getInstance(dropdownToggleEl);
            if (existingDropdown) {
              existingDropdown.dispose();
            }
            
            // Create new dropdown instance
            const dropdown = new bootstrap.Dropdown(dropdownToggleEl);
            console.log('Dropdown initialized for:', dropdownToggleEl);
          } catch (error) {
            console.error('Error initializing dropdown:', error);
          }
        });

        // Initialize all tooltips
        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        tooltipTriggerList.forEach(function(tooltipTriggerEl) {
          try {
            const existingTooltip = bootstrap.Tooltip.getInstance(tooltipTriggerEl);
            if (existingTooltip) {
              existingTooltip.dispose();
            }
            const tooltip = new bootstrap.Tooltip(tooltipTriggerEl);
          } catch (error) {
            console.error('Error initializing tooltip:', error);
          }
        });

        // Initialize all popovers
        const popoverTriggerList = document.querySelectorAll('[data-bs-toggle="popover"]');
        popoverTriggerList.forEach(function(popoverTriggerEl) {
          try {
            const existingPopover = bootstrap.Popover.getInstance(popoverTriggerEl);
            if (existingPopover) {
              existingPopover.dispose();
            }
            const popover = new bootstrap.Popover(popoverTriggerEl);
          } catch (error) {
            console.error('Error initializing popover:', error);
          }
        });
      }

      // Handle clickable table rows
      function initializeClickableRows() {
        const clickableRows = document.querySelectorAll('.clickable-row');
        
        clickableRows.forEach(function(row) {
          // Remove any existing listeners to avoid duplicates
          row.removeEventListener('click', handleRowClick);
          
          // Add the click listener
          row.addEventListener('click', handleRowClick);
        });
      }
      
      function handleRowClick(e) {
        // Don't navigate if clicking on action buttons, links, or form elements
        if (e.target.closest('.action-column') || 
            e.target.closest('.btn') || 
            e.target.closest('a') ||
            e.target.closest('button') ||
            e.target.closest('form') ||
            e.target.closest('input') ||
            e.target.closest('select')) {
          return;
        }
        
        const href = this.getAttribute('data-href');
        if (href) {
          window.location.href = href;
        }
      }


      // Custom profile dropdown implementation
      function initializeProfileDropdown() {
        const profileBtn = document.getElementById('profileDropdownBtn');
        const profileMenu = document.getElementById('profileDropdownMenu');
        
        if (profileBtn && profileMenu) {
          // Remove any existing Bootstrap dropdown instance to prevent conflicts
          if (typeof bootstrap !== 'undefined' && bootstrap.Dropdown) {
            const existingDropdown = bootstrap.Dropdown.getInstance(profileBtn);
            if (existingDropdown) {
              existingDropdown.dispose();
            }
          }
          
          // Remove existing listeners to prevent duplicates
          profileBtn.removeEventListener('click', toggleProfileDropdown);
          document.removeEventListener('click', handleOutsideClick);
          
          // Add click handler for the profile button
          profileBtn.addEventListener('click', toggleProfileDropdown);
          
          // Add click handler for outside clicks
          document.addEventListener('click', handleOutsideClick);
          
          // Add escape key handler
          document.removeEventListener('keydown', handleEscapeKey);
          document.addEventListener('keydown', handleEscapeKey);
          
          // Add window resize handler
          window.removeEventListener('resize', handleWindowResize);
          window.addEventListener('resize', handleWindowResize);
        }
      }
      
      function handleWindowResize() {
        const profileMenu = document.getElementById('profileDropdownMenu');
        const profileBtn = document.getElementById('profileDropdownBtn');
        
        // Reposition dropdown if it's currently open
        if (profileMenu && profileBtn && profileMenu.classList.contains('show')) {
          positionDropdown(profileMenu, profileBtn);
        }
      }
      
      function toggleProfileDropdown(event) {
        event.preventDefault();
        event.stopPropagation();
        
        const profileMenu = document.getElementById('profileDropdownMenu');
        const profileBtn = document.getElementById('profileDropdownBtn');
        
        if (profileMenu && profileBtn) {
          const isVisible = profileMenu.classList.contains('show');
          
          // Close all other dropdowns first
          closeAllDropdowns();
          
          if (isVisible) {
            closeProfileDropdown();
          } else {
            openProfileDropdown();
          }
        }
      }
      
      function openProfileDropdown() {
        const profileMenu = document.getElementById('profileDropdownMenu');
        const profileBtn = document.getElementById('profileDropdownBtn');
        
        if (profileMenu && profileBtn) {
          // Position the dropdown based on available space
          positionDropdown(profileMenu, profileBtn);
          
          profileMenu.classList.add('show');
          profileBtn.setAttribute('aria-expanded', 'true');
        }
      }
      
      function positionDropdown(dropdownMenu, dropdownBtn) {
        // Simple positioning - align dropdown to the right edge of the button
        dropdownMenu.style.position = 'absolute';
        dropdownMenu.style.top = '100%';
        dropdownMenu.style.right = '0';
        dropdownMenu.style.left = 'auto';
        dropdownMenu.style.transform = 'none';
        dropdownMenu.style.marginTop = '0.125rem';
        dropdownMenu.style.marginBottom = '0';
        dropdownMenu.style.minWidth = '200px';
        dropdownMenu.style.zIndex = '1050';
        
        // Check if menu would go off the bottom edge
        const btnRect = dropdownBtn.getBoundingClientRect();
        const menuHeight = dropdownMenu.offsetHeight || 100; // Estimate if not yet rendered
        
        if (btnRect.bottom + menuHeight > window.innerHeight) {
          dropdownMenu.style.top = 'auto';
          dropdownMenu.style.bottom = '100%';
          dropdownMenu.style.marginTop = '0';
          dropdownMenu.style.marginBottom = '0.125rem';
        }
        
        // For very small screens, center the menu
        if (window.innerWidth <= 576) {
          dropdownMenu.style.position = 'fixed';
          dropdownMenu.style.top = '50%';
          dropdownMenu.style.left = '50%';
          dropdownMenu.style.right = 'auto';
          dropdownMenu.style.bottom = 'auto';
          dropdownMenu.style.transform = 'translate(-50%, -50%)';
          dropdownMenu.style.width = '90%';
          dropdownMenu.style.maxWidth = '300px';
        }
      }
      
      function closeProfileDropdown() {
        const profileMenu = document.getElementById('profileDropdownMenu');
        const profileBtn = document.getElementById('profileDropdownBtn');
        
        if (profileMenu && profileBtn) {
          profileMenu.classList.remove('show');
          profileBtn.setAttribute('aria-expanded', 'false');
        }
      }
      
      function closeAllDropdowns() {
        // Close any Bootstrap dropdowns that might be open
        if (typeof bootstrap !== 'undefined' && bootstrap.Dropdown) {
          const dropdowns = document.querySelectorAll('.dropdown-menu.show');
          dropdowns.forEach(dropdown => {
            const dropdownInstance = bootstrap.Dropdown.getInstance(dropdown.previousElementSibling);
            if (dropdownInstance) {
              dropdownInstance.hide();
            }
          });
        }
      }
      
      function handleOutsideClick(event) {
        const profileBtn = document.getElementById('profileDropdownBtn');
        const profileMenu = document.getElementById('profileDropdownMenu');
        
        if (profileBtn && profileMenu && 
            !profileBtn.contains(event.target) && 
            !profileMenu.contains(event.target)) {
          closeProfileDropdown();
        }
      }
      
      function handleEscapeKey(event) {
        if (event.key === 'Escape') {
          closeProfileDropdown();
        }
      }

      // Initialize everything when page loads
      function initializeAll() {
        initializeBootstrapComponents();
        initializeClickableRows();
        initializeProfileDropdown();
        
        // Initialize Select2 for all select elements
        if (typeof $ !== 'undefined' && $.fn.select2) {
          $('.select2-select').each(function() {
            const placeholder = $(this).data('placeholder') || 'Select an option';
            $(this).select2({
              theme: 'default',
              width: '100%',
              placeholder: placeholder,
              allowClear: true
            });
          });
        }
      }

      // Handle both initial page load and Turbo navigation
      document.addEventListener('DOMContentLoaded', initializeAll);
      document.addEventListener('turbo:load', initializeAll);
      document.addEventListener('turbo:render', initializeAll);
      
      // Re-initialize Select2 after Cocoon adds nested fields
      $(document).on('cocoon:after-insert', function(e, insertedItem) {
        if (typeof $ !== 'undefined' && $.fn.select2) {
          insertedItem.find('.select2-select').each(function() {
            const placeholder = $(this).data('placeholder') || 'Select an option';
            $(this).select2({
              theme: 'default',
              width: '100%',
              placeholder: placeholder,
              allowClear: true
            });
          });
        }
      });
    </script>
  </body>
</html>
