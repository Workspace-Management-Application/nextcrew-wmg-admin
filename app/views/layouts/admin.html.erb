<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Admin Dashboard - Workspace Management" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Google Fonts - Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin-body">
    <!-- Sidebar -->
    <div class="sidebar show" id="sidebar">
      <div class="sidebar-header d-flex align-items-center justify-content-between">
        <h4 class="sidebar-title mb-0">Admin Panel</h4>
        <button class="sidebar-toggle btn btn-outline-light ms-2" onclick="toggleSidebar()" style="font-size: 1.5rem;">
          ☰
        </button>
      </div>
      
      <nav class="sidebar-nav">
        <%= link_to admin_dashboard_path, class: "nav-item #{'active' if current_page?(admin_dashboard_path)}" do %>
          <span class="nav-icon">📊</span>
          <span class="nav-text">Dashboard</span>
        <% end %>
        
        <%= link_to admin_workspaces_path, class: "nav-item #{'active' if controller_name == 'workspaces'}" do %>
          <span class="nav-icon">🏢</span>
          <span class="nav-text">Workspace</span>
        <% end %>
        
        <%= link_to admin_bookings_path, class: "nav-item #{'active' if controller_name == 'bookings'}" do %>
          <span class="nav-icon">📅</span>
          <span class="nav-text">Bookings</span>
        <% end %>
        
        <%= link_to admin_users_path, class: "nav-item #{'active' if controller_name == 'users'}" do %>
          <span class="nav-icon">👤</span>
          <span class="nav-text">Users</span>
        <% end %>
        
        <%= link_to admin_companies_path, class: "nav-item #{'active' if controller_name == 'companies'}" do %>
          <span class="nav-icon">🏭</span>
          <span class="nav-text">Companies</span>
        <% end %>
      </nav>
    </div>

    <!-- Floating open sidebar button -->
    <button id="openSidebarBtn" class="btn btn-outline-light position-fixed" style="top: 20px; left: 10px; z-index: 2000; display: none; font-size: 1.5rem;" onclick="toggleSidebar()">
      ☰
    </button>

    <!-- Main Content -->
    <div class="main-content">
      <!-- Top Header -->
      <header class="top-header d-flex align-items-center" style="min-height: 120px; background: #000 !important; color: #fff !important; position: relative;">
        <div class="flex-grow-1 text-center">
          <h2 class="fw-bold mb-1" style="letter-spacing: 2px;">NEXTCOWORKS</h2>
          <hr style="width: 60px; margin: 0.5rem auto; border-top: 2px solid #fff; opacity: 1;">
          <div>Coworking Spaces</div>
          <div>Private Cabin | Private Office | Private Desk | Shared Desk</div>
        </div>
        <!-- Profile Dropdown -->
        <div class="profile-dropdown position-absolute end-0 me-4">
          <button class="profile-btn" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="profile-avatar">
              <%= current_user.name&.first&.upcase || "A" %>
            </div>
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><%= link_to "Edit Profile", admin_profile_path, class: "dropdown-item" %></li>
            <li><hr class="dropdown-divider"></li>
            <li><%= button_to "Logout", destroy_user_session_path, method: :delete, class: "dropdown-item border-0 bg-transparent w-100 text-start", form: { style: "display: inline;" } %></li>
          </ul>
        </div>
      </header>

      <!-- Content Area -->
      <main class="content-area">
        <% if notice %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= notice %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>

        <% if alert %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= alert %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>

        <%= yield %>
      </main>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
      function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        sidebar.classList.toggle('show');
      }
    </script>

    <%= yield :scripts %>
  </body>
</html>
