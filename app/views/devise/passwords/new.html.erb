<!DOCTYPE html>
<html>
  <head>
    <title>Forgot Password - NEXTCOWORKS</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Google Fonts - Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <style>
      /* Password Reset Page Styles - Monochrome Design */
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: #000000 !important;
        color: #ffffff !important;
        margin: 0;
        padding: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .login-container {
        width: 100%;
        max-width: 450px;
        padding: 2rem;
      }

      .login-card {
        background-color: #1a1a1a;
        border: 1px solid #333333;
        border-radius: 12px;
        padding: 3rem 2.5rem;
        box-shadow: 0 8px 32px rgba(255, 255, 255, 0.05);
      }

      .brand-header {
        text-align: center;
        margin-bottom: 2.5rem;
      }

      .brand-title {
        color: #ffffff;
        font-size: 2.5rem;
        font-weight: 700;
        margin: 0 0 0.5rem 0;
        letter-spacing: 1px;
      }

      .brand-subtitle {
        color: #cccccc;
        font-size: 0.95rem;
        font-weight: 400;
        margin: 0;
      }

      .page-title {
        color: #ffffff;
        font-size: 1.5rem;
        font-weight: 600;
        text-align: center;
        margin-bottom: 1rem;
      }

      .page-description {
        color: #cccccc;
        font-size: 0.9rem;
        text-align: center;
        margin-bottom: 2rem;
        line-height: 1.5;
      }

      .form-label {
        color: #ffffff !important;
        font-weight: 500;
        margin-bottom: 0.5rem;
      }

      .form-control {
        background-color: #000000 !important;
        border: 1px solid #333333 !important;
        color: #ffffff !important;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.2s ease;
      }

      .form-control:focus {
        background-color: #000000 !important;
        border-color: #666666 !important;
        box-shadow: 0 0 0 0.2rem rgba(255, 255, 255, 0.1) !important;
        color: #ffffff !important;
      }

      .form-control::placeholder {
        color: #666666 !important;
      }

      .btn-primary {
        background-color: #ffffff !important;
        border-color: #ffffff !important;
        color: #000000 !important;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-size: 1rem;
        width: 100%;
        transition: all 0.2s ease;
      }

      .btn-primary:hover {
        background-color: #e6e6e6 !important;
        border-color: #e6e6e6 !important;
        color: #000000 !important;
        transform: translateY(-1px);
      }

      .btn-primary:focus {
        box-shadow: 0 0 0 0.2rem rgba(255, 255, 255, 0.3) !important;
      }

      .back-link {
        color: #cccccc !important;
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }

      .back-link:hover {
        color: #ffffff !important;
        text-decoration: underline;
      }

      .footer-links {
        text-align: center;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #333333;
      }

      .footer-text {
        color: #666666;
        font-size: 0.85rem;
        margin: 0;
      }

      .alert {
        background-color: #2d1b1b !important;
        border: 1px solid #4a2c2c !important;
        color: #ffffff !important;
        border-radius: 8px;
        margin-bottom: 1.5rem;
      }

      /* Mobile responsive */
      @media (max-width: 576px) {
        .login-container {
          padding: 1rem;
        }
        
        .login-card {
          padding: 2rem 1.5rem;
        }
        
        .brand-title {
          font-size: 2rem;
        }
      }
    </style>
  </head>

  <body>
    <div class="login-container">
      <div class="login-card">
        <!-- Brand Header -->
        <div class="brand-header">
          <h1 class="brand-title">NEXTCOWORKS</h1>
          <p class="brand-subtitle">Coworking Spaces | Private Cabin | Private Office | Private Desk | Shared Desk</p>
        </div>

        <!-- Page Header -->
        <h2 class="page-title">Forgot your password?</h2>
        <p class="page-description">
          Enter your email address and we'll send you instructions to reset your password.
        </p>

        <!-- Password Reset Form -->
        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }, local: true) do |f| %>
          
          <!-- Error Messages -->
          <% if resource.errors.any? %>
            <div class="alert alert-danger" role="alert">
              <h6><%= pluralize(resource.errors.count, "error") %> prohibited this from being saved:</h6>
              <ul class="mb-0">
                <% resource.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-4">
            <%= f.label :email, class: "form-label" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "Enter your email address" %>
          </div>

          <div class="mb-4">
            <%= f.submit "Send reset instructions", class: "btn btn-primary" %>
          </div>
        <% end %>

        <!-- Back to Sign In -->
        <div class="text-center">
          <%= link_to new_session_path(resource_name), class: "back-link" do %>
            ← Back to Sign In
          <% end %>
        </div>

        <!-- Footer -->
        <div class="footer-links">
          <p class="footer-text">Admin Access Only • Workspace Management System</p>
        </div>
      </div>
    </div>
  </body>
</html>
