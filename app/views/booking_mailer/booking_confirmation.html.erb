<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Booking Confirmation</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      line-height: 1.6;
      color: #333;
      margin: 0;
      padding: 0;
      background-color: #f4f4f4;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
    .header {
      background: linear-gradient(135deg, #000000 0%, #333333 100%);
      color: white;
      padding: 30px 20px;
      text-align: center;
    }
    .header h1 {
      margin: 0;
      font-size: 28px;
      font-weight: 700;
      letter-spacing: 2px;
    }
    .header p {
      margin: 10px 0 0 0;
      font-size: 16px;
      opacity: 0.9;
    }
    .content {
      padding: 40px 30px;
    }
    .booking-details {
      background-color: #f8f9fa;
      border-radius: 8px;
      padding: 25px;
      margin: 20px 0;
      border-left: 4px solid #000000;
    }
    .booking-details h2 {
      color: #000000;
      margin-top: 0;
      font-size: 20px;
      font-weight: 600;
    }
    .detail-row {
      display: flex;
      justify-content: space-between;
      margin: 15px 0;
      padding: 10px 0;
      border-bottom: 1px solid #e9ecef;
    }
    .detail-row:last-child {
      border-bottom: none;
    }
    .detail-label {
      font-weight: 600;
      color: #555;
      min-width: 120px;
    }
    .detail-value {
      color: #333;
      text-align: right;
      flex: 1;
    }
    .status-badge {
      background-color: #28a745;
      color: white;
      padding: 5px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .workspace-info {
      background-color: #e9ecef;
      border-radius: 8px;
      padding: 20px;
      margin: 20px 0;
    }
    .workspace-info h3 {
      color: #000000;
      margin-top: 0;
      font-size: 18px;
    }
    .facilities {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 15px;
    }
    .facility-tag {
      background-color: #ffffff;
      color: #333;
      padding: 5px 10px;
      border-radius: 15px;
      font-size: 12px;
      border: 1px solid #ddd;
    }
    .footer {
      background-color: #f8f9fa;
      padding: 30px;
      text-align: center;
      border-top: 1px solid #e9ecef;
    }
    .footer p {
      margin: 5px 0;
      color: #666;
      font-size: 14px;
    }
    .contact-info {
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px solid #e9ecef;
    }
    .contact-info p {
      margin: 5px 0;
      color: #666;
      font-size: 14px;
    }
    .logo {
      font-size: 24px;
      font-weight: 700;
      letter-spacing: 3px;
      margin-bottom: 10px;
    }
    @media only screen and (max-width: 600px) {
      .container {
        margin: 0;
        box-shadow: none;
      }
      .content {
        padding: 20px 15px;
      }
      .detail-row {
        flex-direction: column;
        text-align: left;
      }
      .detail-value {
        text-align: left;
        margin-top: 5px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <div class="header">
      <div class="logo">NEXTCOWORKS</div>
      <h1>Booking Confirmation</h1>
      <p>Your workspace booking has been confirmed!</p>
    </div>

    <!-- Content -->
    <div class="content">
      <p>Dear <%= @company.name %> Team,</p>
      
      <p>Thank you for booking with NEXTCOWORKS! Your reservation has been successfully confirmed. Here are the details of your booking:</p>

      <!-- Booking Details -->
      <div class="booking-details">
        <h2>📅 Booking Information</h2>
        
        <div class="detail-row">
          <span class="detail-label">Booking ID:</span>
          <span class="detail-value">#<%= @booking.id %></span>
        </div>
        
        <div class="detail-row">
          <span class="detail-label">Room:</span>
          <span class="detail-value"><%= @room.name %></span>
        </div>
        
        <div class="detail-row">
          <span class="detail-label">Date:</span>
          <span class="detail-value"><%= @booking.start_time.strftime("%A, %B %d, %Y") %></span>
        </div>
        
        <div class="detail-row">
          <span class="detail-label">Time:</span>
          <span class="detail-value">
            <%= @booking.start_time.strftime("%I:%M %p") %> - <%= @booking.end_time.strftime("%I:%M %p") %>
          </span>
        </div>
        
        <div class="detail-row">
          <span class="detail-label">Duration:</span>
          <span class="detail-value">
            <%= distance_of_time_in_words(@booking.start_time, @booking.end_time) %>
          </span>
        </div>
        
        <div class="detail-row">
          <span class="detail-label">Status:</span>
          <span class="detail-value">
            <span class="status-badge"><%= @booking.status.titleize %></span>
          </span>
        </div>
      </div>

      <!-- Workspace Information -->
      <div class="workspace-info">
        <h3>🏢 Workspace Details</h3>
        <p><strong>Workspace:</strong> <%= @workspace.name %></p>
        <p><strong>Room Category:</strong> <%= @room.category.titleize %></p>
        <p><strong>Capacity:</strong> <%= @room.capacity %> people</p>
        
        <div class="facilities">
          <% if @room.whiteboard? %>
            <span class="facility-tag">📝 Whiteboard</span>
          <% end %>
          <% if @room.projector? %>
            <span class="facility-tag">📽️ Projector</span>
          <% end %>
          <% if @room.tv? %>
            <span class="facility-tag">📺 TV</span>
          <% end %>
          <span class="facility-tag">💻 High-speed WiFi</span>
          <span class="facility-tag">☕ Coffee/Tea</span>
        </div>
      </div>

      <p><strong>Important Notes:</strong></p>
      <ul>
        <li>Please arrive 5 minutes before your scheduled time</li>
        <li>Bring your own laptop and any necessary materials</li>
        <li>Please keep the room clean and organized</li>
        <li>Contact us immediately if you need to reschedule</li>
      </ul>

      <p>We look forward to providing you with a productive workspace experience!</p>
    </div>

    <!-- Footer -->
    <div class="footer">
      <div class="logo">NEXTCOWORKS</div>
      <p>Private Cabin | Private Office | Private Desk | Shared Desk</p>
      
      <div class="contact-info">
        <p><strong>Need to make changes?</strong></p>
        <p>📧 Email: support@nextcoworks.com</p>
        <p>📞 Phone: +91-9876543210</p>
        <p>🌐 Website: www.nextcoworks.com</p>
      </div>
      
      <p style="margin-top: 20px; font-size: 12px; color: #999;">
        This is an automated email. Please do not reply to this message.
      </p>
    </div>
  </div>
</body>
</html> 
