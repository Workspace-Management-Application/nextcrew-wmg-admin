<%= form_with model: [:admin, @office_enquiry], local: true, data: { turbo: false }, class: "needs-validation", novalidate: true do |form| %>
  <% if @office_enquiry.errors.any? %>
    <div class="alert alert-danger">
      <h6><%= pluralize(@office_enquiry.errors.count, "error") %> prohibited this enquiry from being saved:</h6>
      <ul class="mb-0">
        <% @office_enquiry.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :enquirer_name, class: "form-label" %><span class="text-danger">*</span>
      <%= form.text_field :enquirer_name, class: "form-control", required: true %>
    </div>
    <div class="col-md-6 mb-3">
      <%= form.label :company_name, class: "form-label" %><span class="text-danger">*</span>
      <%= form.text_field :company_name, class: "form-control", required: true %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :email, class: "form-label" %><span class="text-danger">*</span>
      <%= form.email_field :email, class: "form-control", required: true %>
    </div>
    <div class="col-md-6 mb-3">
      <%= form.label :phone_number, class: "form-label" %><span class="text-danger">*</span>
      <%= form.telephone_field :phone_number, class: "form-control", required: true %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :no_of_seats, "Number of Seats", class: "form-label" %><span class="text-danger">*</span>
      <%= form.number_field :no_of_seats, class: "form-control", required: true, min: 1 %>
    </div>
    <div class="col-md-6 mb-3">
      <%= form.label :workspace_type_ids, "Workspace Types", class: "form-label" %><span class="text-danger">*</span>
      <%= form.collection_select :workspace_type_ids, @workspace_types, :id, :name, {}, { class: "select2-select", multiple: true, required: true, 'data-placeholder': "Select Workspace Types" } %>
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :workspace_id, "Workspace", class: "form-label" %><span class="text-danger">*</span>
    <%= form.collection_select :workspace_id, @workspaces, :id, :name, { prompt: "Select Workspace" }, { class: "select2-select", required: true, 'data-placeholder': "Select Workspace" } %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit @office_enquiry.persisted? ? "Update Enquiry" : "Create Enquiry", class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_office_enquiries_path, class: "btn btn-secondary" %>
  </div>
<% end %> 