<% content_for :page_title, "Edit Office Enquiry" %>

<div class="row">
  <div class="col-lg-8 col-md-10 mx-auto">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Edit Office Enquiry</h2>
      <%= link_to "← Back to Enquiries", admin_office_enquiries_path, class: "btn btn-outline-primary" %>
    </div>

    <%= form_with model: [:admin, @office_enquiry], local: true, data: { turbo: false }, class: "needs-validation", novalidate: true do |form| %>
      <% if @office_enquiry.errors.any? %>
        <div class="alert alert-danger">
          <h6><%= pluralize(@office_enquiry.errors.count, "error") %> prohibited this enquiry from being saved:</h6>
          <ul class="mb-0">
            <% @office_enquiry.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= form.label :enquirer_name, class: "form-label" %>
          <%= form.text_field :enquirer_name, class: "form-control", required: true %>
        </div>
        <div class="col-md-6 mb-3">
          <%= form.label :company_name, class: "form-label" %>
          <%= form.text_field :company_name, class: "form-control", required: true %>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= form.label :email, class: "form-label" %>
          <%= form.email_field :email, class: "form-control", required: true %>
        </div>
        <div class="col-md-6 mb-3">
          <%= form.label :phone_number, class: "form-label" %>
          <%= form.telephone_field :phone_number, class: "form-control", required: true %>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= form.label :no_of_seats, "Number of Seats", class: "form-label" %>
          <%= form.number_field :no_of_seats, class: "form-control", required: true, min: 1 %>
        </div>
        <div class="col-md-6 mb-3">
          <%= form.label :workspace_type_ids, "Workspace Types", class: "form-label" %>
          <%= form.collection_select :workspace_type_ids, WorkspaceType.order(:name), :id, :name, { selected: @office_enquiry.workspace_type_ids, multiple: true }, { class: "selectpicker", multiple: true, required: true, 'data-live-search': true, title: "Select Workspace Types", 'data-style': 'btn-dark' } %>
        </div>
      </div>

      <div class="mb-3">
        <%= form.label :workspace_id, "Workspace", class: "form-label" %>
        <%= form.collection_select :workspace_id, Workspace.order(:name), :id, :name, { prompt: "Select Workspace" }, { class: "selectpicker", required: true, 'data-live-search': true, title: "Select Workspace", 'data-style': 'btn-dark' } %>
      </div>

      <div class="d-flex gap-2">
        <%= form.submit "Update Enquiry", class: "btn btn-primary" %>
        <%= link_to "Cancel", admin_office_enquiries_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div> 