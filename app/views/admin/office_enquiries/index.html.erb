<% content_for :page_title, "Office Enquiries" %>

<div class="content-area bg-dark text-white p-4 rounded">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Office Enquiries</h2>
    <%= link_to "Add Enquiry", new_admin_office_enquiry_path, class: "btn btn-primary" %>
  </div>

  <!-- Search and Filter Form -->
  <div class="bg-dark p-3 rounded mb-4">
    <%= form_with url: admin_office_enquiries_path, method: :get, local: true, class: "row g-3" do |form| %>
      <div class="col-md-4">
        <%= form.label :search, "Search", class: "form-label" %>
        <div class="d-flex">
          <%= form.text_field :search, placeholder: "Search by name, email, company, requirement...", 
                             value: params[:search], 
                             class: "form-control form-control-dark me-2" %>
          <%= form.submit "Search/Filter", class: "btn btn-outline-primary" %>
        </div>
      </div>
      <div class="col-md-3">
        <%= form.label :workspace_id, "Filter by Workspace", class: "form-label" %>
        <%= form.select :workspace_id, 
                        options_from_collection_for_select(@workspaces, :id, :name, params[:workspace_id]), 
                        { prompt: 'All Workspaces' }, 
                        { class: "form-select form-control-dark", onchange: "this.form.submit();" } %>
      </div>
      <div class="col-md-3">
        <%= form.label :date_from, "Filter by Date", class: "form-label" %>
        <%= form.date_field :date_from, value: params[:date_from], class: "form-control form-control-dark", onchange: "this.form.submit();" %>
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <%= link_to "Clear", admin_office_enquiries_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>

  <!-- Results Info -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <%= pagination_info(@office_enquiries) %>
    </div>
    <div>
      <%= paginate @office_enquiries %>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover table-dark">
      <thead>
        <tr>
          <th>Enquirer Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Company</th>
          <th>Workspace Types</th>
          <th>No. of Seats</th>
          <th>Workspace</th>
          <th>Date</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @office_enquiries.each do |enquiry| %>
          <tr class="clickable-row" data-href="<%= admin_office_enquiry_path(enquiry) %>" style="cursor: pointer;">
            <td><%= enquiry.enquirer_name %></td>
            <td><%= enquiry.email %></td>
            <td><%= enquiry.phone_number %></td>
            <td><%= enquiry.company_name %></td>
            <td>
              <span class="text-truncate d-inline-block" style="max-width: 200px;">
                <%= enquiry.workspace_types.map(&:name).join(', ') %>
              </span>
            </td>
            <td><%= enquiry.no_of_seats %></td>
            <td><%= enquiry.workspace&.name %></td>
            <td><%= enquiry.created_at.strftime("%b %d, %Y") %></td>
            <td class="action-column">
              <%= link_to "Edit", edit_admin_office_enquiry_path(enquiry), class: "btn btn-secondary btn-sm me-2" %>
              <%= link_to "Delete", admin_office_enquiry_path(enquiry), 
                          data: { 
                            turbo_method: :delete, 
                            turbo_confirm: "Are you sure you want to delete this enquiry?" 
                          },
                          class: "btn btn-danger btn-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @office_enquiries.empty? %>
    <div class="text-center mt-5">
      <% if params[:search].present? || params[:workspace_id].present? || params[:date_from].present? || params[:date_to].present? %>
        <p class="text-muted">No office enquiries found matching your search criteria.</p>
        <%= link_to "Clear filters", admin_office_enquiries_path, class: "btn btn-outline-secondary" %>
      <% else %>
        <p class="text-muted">No office enquiries found.</p>
        <%= link_to "Add the first enquiry", new_admin_office_enquiry_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  <% else %>
    <!-- Bottom Pagination -->
    <div class="d-flex justify-content-between align-items-center mt-4">
      <div>
        <%= pagination_info(@office_enquiries) %>
      </div>
      <div>
        <%= paginate @office_enquiries %>
      </div>
    </div>
  <% end %>
</div> 