<% content_for :page_title, @company.name %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2><%= @company.name %></h2>
  <div>
    <%= link_to "Edit", edit_admin_company_path(@company), class: "btn btn-primary me-2" %>
    <%= link_to "← Back to Companies", admin_companies_path, class: "btn btn-outline-primary" %>
  </div>
</div>

<div class="row">
  <div class="col-md-8">
    <!-- Company Details -->
    <div class="bg-dark p-4 rounded mb-4">
      <h4 class="mb-3">Company Information</h4>
      <div class="row">
        <div class="col-md-6">
          <p><strong>Email:</strong> <%= @company.email %></p>
          <p><strong>Phone:</strong> <%= @company.phone_number %></p>
          <p><strong>Cabin Number:</strong> <%= @company.cabin_number %></p>
          <p><strong>Number of Employees:</strong> <%= @company.no_of_employee %></p>
        </div>
        <div class="col-md-6">
          <p><strong>Address:</strong> <%= @company.address %></p>
          <p><strong>Meeting Time Limit per Month:</strong> <%= @company.meeting_time_limit_per_month %> hours</p>
          <p><strong>Meeting Time Limit per Day:</strong> <%= @company.meeting_time_limit_per_day %> minutes</p>
          <p><strong>Number of Meetings per Day:</strong> <%= @company.no_of_meeting_per_day %></p>
          <p><strong>Meeting Duration Limits:</strong> <%= @company.minimum_minutes_meeting_limit %> - <%= @company.max_minutes_meeting_limit %> minutes</p>
        </div>
      </div>
    </div>

    <!-- Additional Company Details -->
    <div class="bg-dark p-4 rounded mb-4">
      <h4 class="mb-3">Additional Company Details</h4>
      <div class="row">
        <div class="col-md-6">
          <p><strong>Company Centre Address:</strong> <%= @company.centre_address %></p>
          <p><strong>Company POC Contact:</strong> <%= @company.company_poc_contact %></p>
          <p><strong>Company Email Address:</strong> <%= @company.company_email_address %></p>
          <p><strong>Floor No:</strong> <%= @company.floor_no %></p>
          <p><strong>No of Seats:</strong> <%= @company.no_of_seats %></p>
          <p><strong>Lock-in Period:</strong> <%= @company.lock_in_period %> months</p>
        </div>
        <div class="col-md-6">
          <p><strong>Cost per Seat / Monthly Rental:</strong> ₹<%= @company.cost_per_seat %></p>
          <p><strong>Commencement Date:</strong> <%= @company.commencement_date&.strftime("%B %d, %Y") %></p>
          <p><strong>Agreement Date:</strong> <%= @company.agreement_date&.strftime("%B %d, %Y") %></p>
          <p><strong>Lease Expiry Date:</strong> <%= @company.lease_expiry_date&.strftime("%B %d, %Y") %></p>
          <p><strong>Shift Type:</strong> <%= @company.shift_type %></p>
          <p><strong>Name Board Charges:</strong> 
            <span class="badge <%= @company.name_board_charges? ? 'bg-success' : 'bg-secondary' %>">
              <%= @company.name_board_charges? ? 'YES' : 'NO' %>
            </span>
          </p>
        </div>
      </div>
    </div>

    <!-- Workspace Information -->
    <% if @company.workspaces.any? %>
      <div class="bg-dark p-4 rounded mb-4">
        <h4 class="mb-3">Workspace Information</h4>
        <% @company.workspaces.each do |workspace| %>
          <div class="row mb-3">
            <div class="col-md-6">
              <p><strong>Workspace Name:</strong> <%= workspace.name %></p>
              <p><strong>Building:</strong> <%= workspace.building_name %></p>
              <p><strong>City:</strong> <%= workspace.city %></p>
            </div>
            <div class="col-md-6">
              <p><strong>Address:</strong> <%= workspace.address %></p>
              <p><strong>Pincode:</strong> <%= workspace.pincode %></p>
              <p><strong>Total Rooms:</strong> <%= workspace.rooms.count %></p>
            </div>
          </div>
          <div class="mt-3">
            <%= link_to "View Workspace Details", admin_workspace_path(workspace), class: "btn btn-outline-primary btn-sm" %>
          </div>
          <% unless workspace == @company.workspaces.last %>
            <hr class="my-4" style="border-color: #333;">
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="bg-dark p-4 rounded mb-4">
        <h4 class="mb-3">Workspace Information</h4>
        <div class="text-center">
          <i class="fas fa-building fa-3x text-muted mb-3"></i>
          <p class="text-muted">No workspaces associated with this company.</p>
        </div>
      </div>
    <% end %>

    <!-- Company Users -->
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4>Company Employee (<%= @company_users.count %>)</h4>
      <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addUserModal">
        <i class="fas fa-plus"></i> Add Users
      </button>
    </div>

    <% if @company_users.any? %>
      <div class="table-responsive">
        <table class="table table-hover table-dark">
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Role</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @company_users.each do |user| %>
              <tr class="clickable-row" data-href="<%= admin_user_path(user) %>" style="cursor: pointer;">
                <td><%= user.name %></td>
                <td><%= user.email %></td>
                <td>
                  <span class="badge <%= user.role == 'super_admin' ? 'bg-light text-dark' : user.role == 'admin' ? 'bg-secondary' : 'bg-dark' %>">
                    <%= user.role.humanize %>
                  </span>
                </td>
                <td>
                  <%= button_to "Remove", remove_user_admin_company_path(@company, user_id: user.id), 
                              method: :delete, 
                              class: "btn btn-danger btn-sm", 
                              data: { confirm: "Are you sure you want to remove this user from the company?" } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center mt-4">
        <p class="text-muted">No users assigned to this company.</p>
      </div>
    <% end %>

    <!-- Associated Rooms -->
    <div class="mt-5">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Associated Rooms (<%= @company.rooms.count %>)</h4>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addRoomModal">
          <i class="fas fa-plus"></i> Add Rooms
        </button>
      </div>
      <% if @company.rooms.any? %>
        <div class="table-responsive">
          <table class="table table-hover table-dark">
            <thead>
              <tr>
                <th>Room Name</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @company.rooms.each do |room| %>
                <tr>
                  <td><%= room.name %></td>
                  <td>
                    <%= button_to "Remove", remove_room_admin_company_path(@company, room_id: room.id), method: :delete, class: "btn btn-danger btn-sm", data: { confirm: "Are you sure you want to remove this room?" } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center mt-4">
          <p class="text-muted">No rooms associated with this company.</p>
        </div>
      <% end %>


    </div>
  </div>

  <div class="col-md-4">
    <!-- Usage Analytics -->
    <div class="bg-dark p-4 rounded">
      <h5 class="mb-3">Usage Analytics</h5>
      
      <div class="metric-card mb-3">
        <div class="metric-value"><%= @usage_analytics[:total_users] %></div>
        <div class="metric-label">Total Users</div>
      </div>
      
      <div class="metric-card mb-3">
        <div class="metric-value"><%= @usage_analytics[:total_bookings] %></div>
        <div class="metric-label">Total Bookings</div>
      </div>
      
      <div class="metric-card mb-3">
        <div class="metric-value"><%= @usage_analytics[:this_month_bookings] %></div>
        <div class="metric-label">This Month Bookings</div>
      </div>
      
      <div class="metric-card">
        <div class="metric-value"><%= @usage_analytics[:active_users] %></div>
        <div class="metric-label">Active Users (30 days)</div>
      </div>
    </div>
  </div>
</div>

<!-- Add User Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content bg-dark text-white">
      <div class="modal-header">
        <h5 class="modal-title" id="addUserModalLabel">Add Users to <%= @company.name %></h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <% if @available_users.any? %>
          <div class="table-responsive">
            <table class="table table-hover table-dark">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Phone</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @available_users.each do |user| %>
                  <tr>
                    <td><%= user.name %></td>
                    <td><%= user.email %></td>
                    <td><%= user.phone_number %></td>
                    <td>
                      <%= button_to "Add to Company", add_user_admin_company_path(@company, user_id: user.id), 
                                  method: :post, 
                                  class: "btn btn-success btn-sm",
                                  data: { confirm: "Add #{user.name} to #{@company.name}?" } %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-4">
            <i class="fas fa-users fa-3x text-muted mb-3"></i>
            <p class="text-muted">No available users found.</p>
            <p class="text-muted small">All users with role 'user' are already assigned to companies.</p>
          </div>
        <% end %>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- Add Room Modal -->
<div class="modal fade" id="addRoomModal" tabindex="-1" aria-labelledby="addRoomModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content bg-dark text-white">
      <div class="modal-header">
        <h5 class="modal-title" id="addRoomModalLabel">Add Rooms to <%= @company.name %></h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <% if @available_rooms.any? %>
          <div class="table-responsive">
            <table class="table table-hover table-dark">
              <thead>
                <tr>
                  <th>Room Name</th>
                  <th>Category</th>
                  <th>Capacity</th>
                  <th>Workspace</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @available_rooms.each do |room| %>
                  <tr>
                    <td><%= room.name %></td>
                    <td><%= room.category.humanize %></td>
                    <td><%= room.capacity %> people</td>
                    <td><%= room.workspace.name %></td>
                    <td>
                      <%= button_to "Add to Company", add_room_admin_company_path(@company, room_id: room.id), 
                                  method: :post, 
                                  class: "btn btn-success btn-sm",
                                  data: { confirm: "Add #{room.name} to #{@company.name}?" } %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-4">
            <i class="fas fa-door-open fa-3x text-muted mb-3"></i>
            <p class="text-muted">No available rooms found.</p>
            <p class="text-muted small">All rooms are already associated with this company.</p>
          </div>
        <% end %>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<%# Add this script at the end of the file to handle clickable rows %>
<script>
  document.addEventListener("DOMContentLoaded", function() {
    document.querySelectorAll(".clickable-row").forEach(function(row) {
      row.addEventListener("click", function(e) {
        // Prevent click if the target is a button inside the row
        if (e.target.closest('button, a, form')) return;
        window.location = row.getAttribute("data-href");
      });
    });
  });
</script>