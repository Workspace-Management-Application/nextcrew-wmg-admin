<% content_for :page_title, "Add User to #{@company.name}" %>

<div class="row">
  <div class="col-lg-8 col-md-10 mx-auto">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Add User to <%= @company.name %></h2>
      <%= link_to "← Back to Company", admin_company_path(@company), class: "btn btn-outline-primary" %>
    </div>

    <%= form_with model: [:admin, @user], local: true, data: { turbo: false }, html: { multipart: true }, class: "needs-validation", novalidate: true do |form| %>
      <% if @user.errors.any? %>
        <div class="alert alert-danger">
          <h6><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h6>
          <ul class="mb-0">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= form.label :name, class: "form-label" do %>
            Name <span class="text-danger">*</span>
          <% end %>
          <%= form.text_field :name, class: "form-control", required: true %>
        </div>
        
        <div class="col-md-6 mb-3">
          <%= form.label :phone_number, class: "form-label" %><span class="text-danger">*</span>
          <%= form.telephone_field :phone_number, class: "form-control" %>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= form.label :email, class: "form-label" do %>
            Email <span class="text-danger">*</span>
          <% end %>
          <%= form.email_field :email, class: "form-control", required: true %>
        </div>
        
        <div class="col-md-6 mb-3">
          <%= form.label :password, class: "form-label" do %>
            Password <span class="text-danger">*</span>
          <% end %>
          <%= form.password_field :password, class: "form-control", required: true %>
        </div>
      </div>

      <div class="mb-3">
        <%= form.label :role, class: "form-label" do %>
          Role <span class="text-danger">*</span>
        <% end %>
        <%= form.select :role, 
                        options_for_select([
                          ['User', 'user']
                        ], 'user'), 
                        {}, 
                        { class: "select2-select", required: true, id: "user_role", 'data-placeholder': 'Select Role' } %>
      </div>

      <div class="mb-3">
        <%= form.label :workspace_id, "Workspace", class: "form-label" %><span class="text-danger">*</span>
        <%= form.select :workspace_id,
          options_from_collection_for_select(@workspaces, :id, :name, @selected_workspace_id),
          { prompt: 'Select Workspace' },
          { class: "select2-select", id: "user_workspace_id", 'data-placeholder': 'Select Workspace' } %>
      </div>

      <div class="mb-3">
        <%= form.label :company_id, "Company", class: "form-label" %><span class="text-danger">*</span>
        <%= form.select :company_id,
          options_from_collection_for_select([@company], :id, :name, @company.id),
          { prompt: 'Select Company' },
          { class: "select2-select", id: "user_company_id", 'data-placeholder': 'Select Company' } %>
      </div>

      <div class="mb-3">
        <%= form.label :company_user_type, "Company Access Type", class: "form-label" %><span class="text-danger">*</span>
        <%= form.select :company_user_type,
                        options_for_select([
                          ['Booking User', 'booking_user'],
                          ['Employee', 'employee']
                        ], @user.company_user_type || 'booking_user'),
                        {},
                        { class: "select2-select", id: "user_company_user_type", 'data-placeholder': 'Select Company Access Type' } %>
      </div>

      <div class="mb-3">
        <%= form.label :documents, "Documents", class: "form-label" %>
        <%= form.file_field :documents,
                            multiple: true,
                            accept: "image/jpeg,image/jpg,image/png,image/gif,image/webp,application/pdf",
                            id: "user_documents",
                            class: "form-control" %>
        <div id="selected_documents" class="mt-2 small text-light"></div>
      </div>

      <%= hidden_field_tag :company_id, @company.id %>
      
      <div class="d-flex gap-2">
        <%= form.submit "Create User", class: "btn btn-primary" %>
        <%= link_to "Cancel", admin_company_path(@company), class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Pre-select workspace and company
  const workspaceSelect = document.getElementById('user_workspace_id');
  const companySelect = document.getElementById('user_company_id');
  const documentsInput = document.getElementById('user_documents');
  const selectedDocuments = document.getElementById('selected_documents');

  function updateSelectedDocuments() {
    if (!documentsInput || !selectedDocuments) return;

    const files = Array.from(documentsInput.files || []);
    if (files.length === 0) {
      selectedDocuments.innerHTML = '';
      return;
    }

    selectedDocuments.innerHTML = '';

    const label = document.createElement('div');
    label.className = 'mb-1';
    label.textContent = 'Selected files:';
    selectedDocuments.appendChild(label);

    const list = document.createElement('ul');
    list.className = 'mb-0 ps-3';
    files.forEach(file => {
      const item = document.createElement('li');
      item.textContent = file.name;
      list.appendChild(item);
    });
    selectedDocuments.appendChild(list);
  }

  documentsInput?.addEventListener('change', updateSelectedDocuments);

  if (workspaceSelect && '<%= @selected_workspace_id %>') {
    workspaceSelect.value = '<%= @selected_workspace_id %>';
    if (window.$ && $.fn.select2) {
      $(workspaceSelect).val('<%= @selected_workspace_id %>').trigger('change.select2');
    }
  }
  
  if (companySelect && '<%= @company.id %>') {
    companySelect.value = '<%= @company.id %>';
    if (window.$ && $.fn.select2) {
      $(companySelect).val('<%= @company.id %>').trigger('change.select2');
    }
  }
});

document.addEventListener('turbo:load', function() {
  // Pre-select workspace and company
  const workspaceSelect = document.getElementById('user_workspace_id');
  const companySelect = document.getElementById('user_company_id');
  const documentsInput = document.getElementById('user_documents');
  const selectedDocuments = document.getElementById('selected_documents');

  function updateSelectedDocuments() {
    if (!documentsInput || !selectedDocuments) return;

    const files = Array.from(documentsInput.files || []);
    if (files.length === 0) {
      selectedDocuments.innerHTML = '';
      return;
    }

    selectedDocuments.innerHTML = '';

    const label = document.createElement('div');
    label.className = 'mb-1';
    label.textContent = 'Selected files:';
    selectedDocuments.appendChild(label);

    const list = document.createElement('ul');
    list.className = 'mb-0 ps-3';
    files.forEach(file => {
      const item = document.createElement('li');
      item.textContent = file.name;
      list.appendChild(item);
    });
    selectedDocuments.appendChild(list);
  }

  documentsInput?.addEventListener('change', updateSelectedDocuments);

  if (workspaceSelect && '<%= @selected_workspace_id %>') {
    workspaceSelect.value = '<%= @selected_workspace_id %>';
    if (window.$ && $.fn.select2) {
      $(workspaceSelect).val('<%= @selected_workspace_id %>').trigger('change.select2');
    }
  }
  
  if (companySelect && '<%= @company.id %>') {
    companySelect.value = '<%= @company.id %>';
    if (window.$ && $.fn.select2) {
      $(companySelect).val('<%= @company.id %>').trigger('change.select2');
    }
  }
});
</script>
