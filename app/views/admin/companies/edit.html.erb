<% content_for :page_title, "Edit Company" %>

<div class="row">
  <div class="col-lg-8 col-md-10 mx-auto">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Edit Company</h2>
      <%= link_to "← Back to Company", admin_company_path(@company), class: "btn btn-outline-primary" %>
    </div>

    <%= form_with model: [:admin, @company], local: true, class: "needs-validation", novalidate: true do |form| %>
      <% if @company.errors.any? %>
        <div class="alert alert-danger">
          <h6><%= pluralize(@company.errors.count, "error") %> prohibited this company from being saved:</h6>
          <ul class="mb-0">
            <% @company.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= form.label :name, "Company Name", class: "form-label" %>
          <%= form.text_field :name, class: "form-control", required: true %>
        </div>
        
        <div class="col-md-6 mb-3">
          <%= form.label :email, class: "form-label" %>
          <%= form.email_field :email, class: "form-control", required: true %>
        </div>
      </div>

      <!-- Status field - only visible to super_admin or admin with restrictions -->
      <% if current_user.super_admin? %>
        <div class="row">
          <div class="col-md-6 mb-3">
          <%= form.label :status, class: "form-label" %>
          <%= form.select :status, 
              options_for_select([
                ['Pending', 'pending'],
                ['Active', 'active'],
                ['Approved', 'approved'],
                ['Inactive', 'inactive']
              ], @company.status), 
              {}, 
              { class: "form-select" } %>
        </div>
      </div>
      <% elsif current_user.admin? && @company.status == 'active' %>
        <div class="row">
          <div class="col-md-6 mb-3">
            <%= form.label :status, class: "form-label" %>
            <%= form.select :status, 
                options_for_select([
                  ['Active', 'active'],
                  ['Inactive', 'inactive']
                ], @company.status), 
                {}, 
                { class: "form-select" } %>
            <small class="form-text text-muted">Admin can only change status from Active to Inactive</small>
          </div>
        </div>
      <% else %>
        <!-- Hidden field to preserve current status -->
        <%= form.hidden_field :status %>
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label">Current Status</label>
            <div class="form-control-plaintext">
              <span class="badge <%= @company.status == 'active' ? 'bg-success' : @company.status == 'pending' ? 'bg-warning' : 'bg-secondary' %>">
                <%= @company.status.titleize %>
              </span>
              <% unless current_user.super_admin? %>
                <small class="form-text text-muted d-block mt-1">Only Super Admin can change this status</small>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= form.label :email, class: "form-label" %>
          <%= form.email_field :email, class: "form-control", required: true %>
        </div>
        
        <div class="col-md-6 mb-3">
          <%= form.label :phone_number, "Phone Number", class: "form-label" %>
          <%= form.telephone_field :phone_number, class: "form-control", required: true %>
        </div>
      </div>

      <div class="mb-3">
        <%= form.label :address, class: "form-label" %>
        <%= form.text_area :address, class: "form-control", rows: 3, required: true %>
      </div>

      <div class="d-flex gap-2">
        <%= form.submit "Update Company", class: "btn btn-primary" %>
        <%= link_to "Cancel", admin_company_path(@company), class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div> 