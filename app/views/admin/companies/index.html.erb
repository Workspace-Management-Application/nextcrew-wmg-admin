<% content_for :page_title, "Companies" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Companies</h2>
  <%= link_to "Add Company", new_admin_company_path, class: "btn btn-primary" %>
</div>

<div class="table-responsive">
  <table class="table table-hover">
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Total Users</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @companies.each do |company| %>
        <tr>
          <td><%= company.name %></td>
          <td><%= company.email %></td>
          <td><%= company.phone_number %></td>
          <td><%= company.users.count %></td>
          <td>
            <%= link_to "View", admin_company_path(company), class: "btn btn-outline-primary btn-sm me-2" %>
            <%= link_to "Edit", edit_admin_company_path(company), class: "btn btn-secondary btn-sm me-2" %>
            <%= link_to "Export", export_data_admin_company_path(company, format: :xlsx), class: "btn btn-outline-primary btn-sm me-2" %>
            <%= link_to "Delete", admin_company_path(company), method: :delete, 
                        class: "btn btn-danger btn-sm",
                        confirm: "Are you sure you want to delete this company?" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @companies.empty? %>
  <div class="text-center mt-5">
    <p class="text-muted">No companies found.</p>
    <%= link_to "Add the first company", new_admin_company_path, class: "btn btn-primary" %>
  </div>
<% end %>
