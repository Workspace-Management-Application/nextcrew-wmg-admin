<% content_for :page_title, "Edit Booking" %>

<div class="row">
  <div class="col-lg-8 col-md-10 mx-auto">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Edit Booking</h2>
      <%= link_to "← Back to Booking", admin_booking_path(@booking), class: "btn btn-outline-primary" %>
    </div>

    <%= form_with model: [:admin, @booking], local: true, data: { turbo: false }, class: "needs-validation", novalidate: true do |form| %>
      <% if @booking.errors.any? %>
        <div class="alert alert-danger">
          <h6><%= pluralize(@booking.errors.count, "error") %> prohibited this booking from being saved:</h6>
          <ul class="mb-0">
            <% @booking.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= form.label :company_id, "Company", class: "form-label" %>
          <%= form.select :company_id, 
                          options_from_collection_for_select(@companies, :id, ->(company) { "#{company.name} (#{company.email})" }, @booking.company_id), 
                          { prompt: 'Select Company' }, 
                          { class: "select2-select", required: true, id: "company_select", 'data-placeholder': 'Select Company' } %>
        </div>
        
        <div class="col-md-6 mb-3">
          <%= form.label :room_id, "Room", class: "form-label" %>
          <%= form.select :room_id, 
                          options_from_collection_for_select(@rooms, :id, ->(room) { "#{room.name} - #{room.workspace.name}" }, @booking.room_id), 
                          { prompt: 'Select Room' }, 
                          { class: "select2-select", required: true, id: "room_select", 'data-placeholder': 'Select Room' } %>
        </div>
      </div>

      <div class="mb-3">
        <%= form.label :phone_number, class: "form-label" %>
        <%= form.telephone_field :phone_number, class: "form-control", required: true, placeholder: "Enter phone number" %>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= form.label :start_time, class: "form-label" %>
          <%= form.datetime_local_field :start_time, 
              class: "form-control", 
              required: true,
              value: (@booking.start_time&.strftime("%Y-%m-%dT%H:%M") if @booking.start_time) %>
        </div>
        
        <div class="col-md-6 mb-3">
          <%= form.label :end_time, class: "form-label" %>
          <%= form.datetime_local_field :end_time, 
              class: "form-control", 
              required: true,
              value: (@booking.end_time&.strftime("%Y-%m-%dT%H:%M") if @booking.end_time) %>
        </div>
      </div>

      <div class="d-flex gap-2">
        <%= form.submit "Update Booking", class: "btn btn-primary" %>
        <%= link_to "Cancel", admin_booking_path(@booking), class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  initializeEditBookingForm();
});

document.addEventListener('turbo:load', function() {
  initializeEditBookingForm();
});

function initializeEditBookingForm() {
  const companySelect = document.getElementById('company_select');
  const roomSelect = document.getElementById('room_select');
  const currentRoomId = <%= @booking.room_id %>;

  if (!companySelect || !roomSelect) return;

  function loadRoomsForCompany(companyId) {
    if (companyId) {
      // Show loading
      const originalOptions = roomSelect.innerHTML;
      roomSelect.innerHTML = '<option value="">Loading rooms...</option>';
      
      // Reinitialize Select2 for room select
      if (typeof $ !== 'undefined' && $.fn.select2) {
        $(roomSelect).select2('destroy');
        $(roomSelect).select2({
          theme: 'default',
          width: '100%',
          placeholder: 'Loading rooms...',
          allowClear: true
        });
      }
      
      // Fetch rooms for the selected company
      fetch(`<%= company_rooms_admin_bookings_path %>?company_id=${companyId}`)
        .then(response => response.json())
        .then(rooms => {
          // Clear existing options
          roomSelect.innerHTML = '<option value="">Select Room</option>';
          
          // Add room options
          rooms.forEach(room => {
            const option = document.createElement('option');
            option.value = room.id;
            option.textContent = room.name;
            if (room.id === currentRoomId) {
              option.selected = true;
            }
            roomSelect.appendChild(option);
          });
          
          if (rooms.length === 0) {
            roomSelect.innerHTML = '<option value="">No rooms available for this company</option>';
          }
          
          // Reinitialize Select2 after options are added
          if (typeof $ !== 'undefined' && $.fn.select2) {
            $(roomSelect).select2('destroy');
            $(roomSelect).select2({
              theme: 'default',
              width: '100%',
              placeholder: 'Select Room',
              allowClear: true
            });
          }
        })
        .catch(error => {
          console.error('Error fetching rooms:', error);
          roomSelect.innerHTML = originalOptions; // Restore original options on error
          if (typeof $ !== 'undefined' && $.fn.select2) {
            $(roomSelect).select2('destroy');
            $(roomSelect).select2({
              theme: 'default',
              width: '100%',
              placeholder: 'Select Room',
              allowClear: true
            });
          }
        });
    }
  }

  // Event listener using jQuery for Select2 compatibility
  if (typeof $ !== 'undefined' && $.fn.select2) {
    $(companySelect).on('change', function() {
      loadRoomsForCompany(this.value);
    });
  } else {
    // Fallback to native event listener
    companySelect.addEventListener('change', function() {
      loadRoomsForCompany(this.value);
    });
  }
}
</script>
