<% content_for :page_title, "Edit Booking" %>

<div class="row">
  <div class="col-lg-8 col-md-10 mx-auto">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Edit Booking</h2>
      <%= link_to "← Back to Booking", admin_booking_path(@booking), class: "btn btn-outline-primary" %>
    </div>

    <%= form_with model: [:admin, @booking], local: true, data: { turbo: false }, class: "needs-validation", novalidate: true do |form| %>
      <% if @booking.errors.any? %>
        <div class="alert alert-danger">
          <h6><%= pluralize(@booking.errors.count, "error") %> prohibited this booking from being saved:</h6>
          <ul class="mb-0">
            <% @booking.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= form.label :user_id, "User", class: "form-label" %>
          <%= form.select :user_id, 
                          options_from_collection_for_select(@users, :id, ->(user) { "#{user.name} (#{user.email})" }, @booking.user_id), 
                          { prompt: 'Select User' }, 
                          { class: "form-select", required: true } %>
        </div>
        
        <div class="col-md-6 mb-3">
          <%= form.label :room_id, "Room", class: "form-label" %>
          <%= form.select :room_id, 
                          options_from_collection_for_select(@rooms, :id, ->(room) { "#{room.name} - #{room.workspace.name}" }, @booking.room_id), 
                          { prompt: 'Select Room' }, 
                          { class: "form-select", required: true } %>
        </div>
      </div>

      <div class="mb-3">
        <%= form.label :phone_number, class: "form-label" %>
        <%= form.telephone_field :phone_number, class: "form-control", required: true, placeholder: "Enter phone number" %>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= form.label :start_time, class: "form-label" %>
          <%= form.datetime_local_field :start_time, 
              class: "form-control", 
              required: true,
              value: (@booking.start_time&.strftime("%Y-%m-%dT%H:%M") if @booking.start_time) %>
        </div>
        
        <div class="col-md-6 mb-3">
          <%= form.label :end_time, class: "form-label" %>
          <%= form.datetime_local_field :end_time, 
              class: "form-control", 
              required: true,
              value: (@booking.end_time&.strftime("%Y-%m-%dT%H:%M") if @booking.end_time) %>
        </div>
      </div>

      <div class="d-flex gap-2">
        <%= form.submit "Update Booking", class: "btn btn-primary" %>
        <%= link_to "Cancel", admin_booking_path(@booking), class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
