<% content_for :page_title, "Create Booking" %>

<div class="row">
  <div class="col-lg-8 col-md-10 mx-auto">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Create New Booking</h2>
      <%= link_to "← Back to Bookings", admin_bookings_path, class: "btn btn-outline-primary" %>
    </div>

    <%= form_with model: [:admin, @booking], local: true, data: { turbo: false }, class: "needs-validation", novalidate: true do |form| %>
      <% if @booking.errors.any? %>
        <div class="alert alert-danger">
          <h6><%= pluralize(@booking.errors.count, "error") %> prohibited this booking from being saved:</h6>
          <ul class="mb-0">
            <% @booking.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= form.label :company_id, class: "form-label" do %>
            Company <span class="text-danger">*</span>
          <% end %>
          <%= form.select :company_id, 
                          options_from_collection_for_select(@companies, :id, ->(company) { "#{company.name} (#{company.email})" }), 
                          { prompt: 'Select Company' }, 
                          { class: "form-select", required: true, id: "company_select" } %>
        </div>
        
        <div class="col-md-6 mb-3">
          <%= form.label :room_id, class: "form-label" do %>
            Room <span class="text-danger">*</span>
          <% end %>
          <%= form.select :room_id, 
                          options_for_select([]), 
                          { prompt: 'Select Company First' }, 
                          { class: "form-select", required: true, id: "room_select", disabled: true } %>
        </div>
      </div>

      <div class="mb-3">
        <%= form.label :phone_number, class: "form-label" do %>
          Phone Number <span class="text-danger">*</span>
        <% end %>
        <%= form.telephone_field :phone_number, class: "form-control", required: true, placeholder: "Enter phone number" %>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= form.label :start_time, class: "form-label" do %>
            Start Time <span class="text-danger">*</span>
          <% end %>
          <%= form.datetime_local_field :start_time, class: "form-control", required: true %>
        </div>
        
        <div class="col-md-6 mb-3">
          <%= form.label :end_time, class: "form-label" do %>
            End Time <span class="text-danger">*</span>
          <% end %>
          <%= form.datetime_local_field :end_time, class: "form-control", required: true %>
        </div>
      </div>

      <div class="d-flex gap-2">
        <%= form.submit "Create Booking", class: "btn btn-primary" %>
        <%= link_to "Cancel", request.referer || admin_bookings_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const companySelect = document.getElementById('company_select');
  const roomSelect = document.getElementById('room_select');

  companySelect.addEventListener('change', function() {
    const companyId = this.value;
    
    if (companyId) {
      // Enable room dropdown and show loading
      roomSelect.disabled = false;
      roomSelect.innerHTML = '<option value="">Loading rooms...</option>';
      
      // Fetch rooms for the selected company
      fetch(`<%= company_rooms_admin_bookings_path %>?company_id=${companyId}`)
        .then(response => response.json())
        .then(rooms => {
          // Clear existing options
          roomSelect.innerHTML = '<option value="">Select Room</option>';
          
          // Add room options
          rooms.forEach(room => {
            const option = document.createElement('option');
            option.value = room.id;
            option.textContent = room.name;
            roomSelect.appendChild(option);
          });
          
          if (rooms.length === 0) {
            roomSelect.innerHTML = '<option value="">No rooms available for this company</option>';
          }
        })
        .catch(error => {
          console.error('Error fetching rooms:', error);
          roomSelect.innerHTML = '<option value="">Error loading rooms</option>';
        });
    } else {
      // Reset room dropdown
      roomSelect.disabled = true;
      roomSelect.innerHTML = '<option value="">Select Company First</option>';
    }
  });
});
</script>
