<%= form_with model: [:admin, @user], local: true, data: { turbo: false }, class: "needs-validation", novalidate: true do |form| %>
  <% if @user.errors.any? %>
    <div class="alert alert-danger">
      <h6><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h6>
      <ul class="mb-0">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :name, class: "form-label" do %>
        Name <span class="text-danger">*</span>
      <% end %>
      <%= form.text_field :name, class: "form-control", required: true %>
    </div>
    
    <div class="col-md-6 mb-3">
      <%= form.label :phone_number, class: "form-label" %><span class="text-danger">*</span>
      <%= form.telephone_field :phone_number, class: "form-control" %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :email, class: "form-label" do %>
        Email <span class="text-danger">*</span>
      <% end %>
      <%= form.email_field :email, class: "form-control", required: true %>
    </div>
    
    <div class="col-md-6 mb-3">
      <% if @user.persisted? %>
        <%= form.label :password, "Password (leave blank to keep current)", class: "form-label" %>
        <%= form.password_field :password, class: "form-control", autocomplete: "new-password" %>
      <% else %>
        <%= form.label :password, class: "form-label" do %>
          Password <span class="text-danger">*</span>
        <% end %>
        <%= form.password_field :password, class: "form-control", required: true %>
      <% end %>
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :role, class: "form-label" do %>
      Role <span class="text-danger">*</span>
    <% end %>
    <%= form.select :role, 
                    options_for_select([
                      ['User', 'user'],
                      ['Floor User', 'floor_user'],
                      ['Admin', 'admin'],
                      ['Super Admin', 'super_admin']
                    ], @user.role), 
                    { prompt: 'Select Role' }, 
                    { class: "select2-select", required: true, id: "user_role", 'data-placeholder': 'Select Role' } %>
  </div>

  <div class="mb-3" id="workspace_field">
    <%= form.label :workspace_id, "Workspace", class: "form-label" %><span class="text-danger">*</span>
    <%= form.select :workspace_id,
      options_from_collection_for_select(@workspaces, :id, :name, @user.workspaces.first&.id),
      { prompt: 'Select Workspace' },
      { class: "select2-select", id: "user_workspace_id", 'data-placeholder': 'Select Workspace' } %>
  </div>

  <div class="mb-3" id="company_field" style="display: none;">
    <%= form.label :company_id, "Company", class: "form-label" %><span class="text-danger">*</span>
    <%= form.select :company_id,
      @user.persisted? && defined?(@user_workspace_companies) ? options_from_collection_for_select(@user_workspace_companies, :id, :name, @user.companies.first&.id) : (@user.persisted? ? options_from_collection_for_select(@user.companies, :id, :name, @user.companies.first&.id) : []),
      { prompt: 'Select Company' },
      { class: "select2-select", id: "user_company_id", 'data-placeholder': 'Select Company' } %>
  </div>

  <% if @user.persisted? && @user.workspaces.any? %>
    <div class="mb-3">
      <strong>Current Workspace:</strong>
      <%= @user.workspaces.first.name %>
    </div>
  <% end %>

  <div class="d-flex gap-2">
    <%= form.submit @user.persisted? ? "Update User" : "Create User", class: "btn btn-primary" %>
    <%= link_to "Cancel", request.referer || admin_users_path, class: "btn btn-secondary" %>
  </div>
<% end %>

<script>
document.addEventListener('DOMContentLoaded', function() {
  initializeUserForm();
});

document.addEventListener('turbo:load', function() {
  initializeUserForm();
});

function initializeUserForm() {
  const roleSelect = document.getElementById('user_role');
  const workspaceField = document.getElementById('workspace_field');
  const companyField = document.getElementById('company_field');
  const workspaceSelect = document.getElementById('user_workspace_id');
  const companySelect = document.getElementById('user_company_id');

  if (!roleSelect || !workspaceSelect || !companySelect) return;

  function updateFormVisibility() {
    const selectedRole = roleSelect.value;
    
    if (selectedRole === 'user') {
      workspaceField.style.display = 'block';
      companyField.style.display = 'block';
    } else if (selectedRole === 'floor_user') {
      workspaceField.style.display = 'block';
      companyField.style.display = 'none';
    } else if (selectedRole === 'admin') {
      workspaceField.style.display = 'block';
      companyField.style.display = 'none';
    } else {
      workspaceField.style.display = 'none';
      companyField.style.display = 'none';
    }
  }

  function loadCompaniesForWorkspace(workspaceId) {
    if (!workspaceId) {
      companySelect.innerHTML = '<option value="">Select Company</option>';
      if (typeof $ !== 'undefined' && $.fn.select2) {
        $(companySelect).select2('destroy');
        $(companySelect).select2({
          theme: 'default',
          width: '100%',
          placeholder: 'Select Company',
          allowClear: true
        });
      }
      return;
    }

    // For edit form, if the workspace hasn't changed, don't reload companies
    <% if @user.persisted? %>
    const currentWorkspaceId = '<%= @user.workspaces.first&.id %>';
    if (workspaceId === currentWorkspaceId && companySelect.options.length > 1) {
      // Workspace hasn't changed and companies are already loaded, just ensure Select2 is initialized
      if (typeof $ !== 'undefined' && $.fn.select2) {
        $(companySelect).select2('destroy');
        $(companySelect).select2({
          theme: 'default',
          width: '100%',
          placeholder: 'Select Company',
          allowClear: true
        });
      }
      return;
    }
    <% end %>

    fetch(`/admin/users/companies_for_workspace?workspace_id=${workspaceId}`)
      .then(response => response.json())
      .then(data => {
        companySelect.innerHTML = '<option value="">Select Company</option>';
        data.companies.forEach(company => {
          const option = document.createElement('option');
          option.value = company.id;
          option.textContent = company.name;
          companySelect.appendChild(option);
        });
        
        // Reinitialize Select2 after options are added
        if (typeof $ !== 'undefined' && $.fn.select2) {
          $(companySelect).select2('destroy');
          $(companySelect).select2({
            theme: 'default',
            width: '100%',
            placeholder: 'Select Company',
            allowClear: true
          });
        }
      })
      .catch(error => {
        console.error('Error loading companies:', error);
        companySelect.innerHTML = '<option value="">Error loading companies</option>';
        if (typeof $ !== 'undefined' && $.fn.select2) {
          $(companySelect).select2('destroy');
          $(companySelect).select2({
            theme: 'default',
            width: '100%',
            placeholder: 'Select Company',
            allowClear: true
          });
        }
      });
  }

  // Event listeners using jQuery for Select2 compatibility
  if (typeof $ !== 'undefined' && $.fn.select2) {
    $(roleSelect).on('change', updateFormVisibility);
    $(workspaceSelect).on('change', function() {
      if (roleSelect.value === 'user') {
        loadCompaniesForWorkspace(this.value);
      }
    });
  } else {
    // Fallback to native event listeners
    roleSelect.addEventListener('change', updateFormVisibility);
    workspaceSelect.addEventListener('change', function() {
      if (roleSelect.value === 'user') {
        loadCompaniesForWorkspace(this.value);
      }
    });
  }

  // Initialize form state
  updateFormVisibility();
  
  // Load companies if user role is selected and workspace is already set (for edit form)
  if (roleSelect.value === 'user' && workspaceSelect.value) {
    loadCompaniesForWorkspace(workspaceSelect.value);
  }
  
  // For edit form with user role, ensure company field is visible and company is selected
  <% if @user.persisted? && @user.user? %>
  if (roleSelect.value === 'user') {
    companyField.style.display = 'block';
  }
  <% end %>
  
  // For edit form, ensure company is properly selected after Select2 initialization
  <% if @user.persisted? && @user.user? && @user.companies.first %>
  setTimeout(() => {
    if (companySelect && '<%= @user.companies.first.id %>') {
      companySelect.value = '<%= @user.companies.first.id %>';
      if (typeof $ !== 'undefined' && $.fn.select2) {
        $(companySelect).val('<%= @user.companies.first.id %>').trigger('change.select2');
      }
    }
  }, 200);
  <% end %>
}
</script> 