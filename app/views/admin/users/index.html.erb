<% content_for :page_title, "Users" %>

<div class="content-area bg-dark text-white p-4 rounded">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Users</h2>
    <%= link_to "Add User", new_admin_user_path, data: { turbo: false }, class: "btn btn-primary" %>
  </div>

  <!-- Search and Filter Form -->
  <div class="row mb-4">
    <div class="col-md-8">
      <label class="form-label">Search Users</label>
      <%= form_with url: admin_users_path, method: :get, local: true, class: "d-flex gap-2" do |form| %>
        <%= form.text_field :search, value: @search, placeholder: "Search by name, email, or role...", 
                           class: "form-control", style: "background: #2d2d2d; border: 1px solid #555; color: #fff;" %>
        <%= form.submit "Search", class: "btn btn-outline-light" %>
        <% if @search.present? || params[:role].present? %>
          <%= link_to "Clear", admin_users_path, class: "btn btn-outline-secondary" %>
        <% end %>
      <% end %>
    </div>
    <div class="col-md-4">
      <label class="form-label">Filter by Role</label>
      <%= form_with url: admin_users_path, method: :get, local: true, class: "d-flex gap-2" do |form| %>
        <%= form.hidden_field :search, value: @search %>
        <%= form.select :role, 
                       options_for_select([
                         ['All Roles', ''],
                         ['Super Admin', 'super_admin'],
                         ['Admin', 'admin'],
                         ['Floor User', 'floor_user'],
                         ['User', 'user']
                       ], params[:role]), 
                       {}, 
                       { class: "form-select", style: "background: #2d2d2d; border: 1px solid #555; color: #fff;",
                         onchange: "this.form.submit();" } %>
      <% end %>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover table-dark">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Company</th>
          <th>Workspace</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr class="clickable-row" data-href="<%= admin_user_path(user) %>" style="cursor: pointer;">
            <td><%= user.name %></td>
            <td><%= user.email %></td>
            <td>
              <span class="badge <%= user.role == 'super_admin' ? 'bg-light text-dark' : user.role == 'admin' ? 'bg-secondary' : 'bg-dark' %>">
                <%= user.role.humanize %>
              </span>
            </td>
            <td><%= user.companies.any? ? user.companies.pluck(:name).join(', ') : 'Not assigned' %></td>
            <td><%= user.workspaces.any? ? user.workspaces.pluck(:name).join(', ') : 'Not assigned' %></td>
            <td class="action-column">
              <%= link_to "Edit", edit_admin_user_path(user), class: "btn btn-secondary btn-sm me-2", data: { turbo: false } %>
              <% if current_user.super_admin? && user.admin? %>
                <%= link_to "Assign Workspace", assign_workspace_admin_user_path(user), class: "btn btn-outline-primary btn-sm me-2" %>
              <% end %>
              <%= link_to "Delete", admin_user_path(user), 
                          data: { 
                            turbo_method: :delete, 
                            turbo_confirm: "Are you sure you want to delete this user?" 
                          },
                          class: "btn btn-danger btn-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- Pagination and Results Info -->
  <div class="d-flex justify-content-between align-items-center mt-4">
    <div class="text-muted">
      <%= pagination_info(@users) %>
    </div>
    <div>
      <%= paginate @users %>
    </div>
  </div>

  <% if @users.empty? %>
    <div class="text-center mt-5">
      <% if @search.present? || params[:role].present? %>
        <p class="text-muted">No users found matching your search criteria.</p>
        <%= link_to "Clear filters", admin_users_path, class: "btn btn-outline-secondary" %>
      <% else %>
        <p class="text-muted">No users found.</p>
        <%= link_to "Add the first user", new_admin_user_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  <% end %>
</div>
