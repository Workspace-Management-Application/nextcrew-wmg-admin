<% content_for :page_title, "Assign Workspace to #{@user.name}" %>

<div class="row">
  <div class="col-lg-8 col-md-10 mx-auto">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Assign Workspace</h2>
      <%= link_to "← Back to User", admin_users_path, class: "btn btn-outline-primary" %>
    </div>

    <div class="bg-dark p-4 rounded mb-4">
      <h4>User Information</h4>
      <p><strong>Name:</strong> <%= @user.name %></p>
      <p><strong>Email:</strong> <%= @user.email %></p>
      <p><strong>Role:</strong> <%= @user.role.humanize %></p>
      <p><strong>Current Workspaces:</strong> <%= @user.workspaces.any? ? @user.workspaces.pluck(:name).join(', ') : 'Not assigned' %></p>
    </div>

    <%= form_with url: assign_workspace_admin_user_path(@user), method: :patch, local: true, data: { turbo: false } do |form| %>
      <%= hidden_field_tag :assign_settings, "1" %>

      <div class="mb-4">
        <%= form.label :workspace_ids, "Select Workspaces", class: "form-label" %>
        <div class="workspace-selection">
          <% @workspaces.each do |workspace| %>
            <div class="form-check mb-2">
              <%= form.check_box "workspace_ids[]", 
                                { 
                                  class: "form-check-input", 
                                  id: "workspace_#{workspace.id}",
                                  checked: @user.workspaces.include?(workspace)
                                }, 
                                workspace.id, 
                                nil %>
              <%= form.label "workspace_#{workspace.id}", workspace.name, class: "form-check-label" %>
              <small class="text-muted d-block ms-4">
                <%= workspace.building_name %> • <%= workspace.city %>
              </small>
            </div>
          <% end %>
        </div>
        <small class="form-text text-muted">Select multiple workspaces to assign this admin user to manage</small>
      </div>

      <% if @user.admin? %>
        <hr class="my-4">
        <div class="mb-4">
          <label class="form-label">Visible Sidebar Items</label>
          <div class="row">
            <% @sidebar_items.each do |key, label| %>
              <div class="col-md-6 mb-2">
                <div class="form-check">
                  <%= check_box_tag "sidebar_items[]",
                                    key,
                                    @user.sidebar_item_visible?(key),
                                    class: "form-check-input",
                                    id: "sidebar_item_#{key}" %>
                  <%= label_tag "sidebar_item_#{key}", label, class: "form-check-label" %>
                </div>
              </div>
            <% end %>
          </div>
          <small class="form-text text-muted">Choose which sidebar links this admin can see.</small>
        </div>
      <% end %>

      <div class="d-flex gap-2">
        <%= form.submit "Save Settings", class: "btn btn-primary" %>
        <%= link_to "Cancel", admin_user_path(@user), class: "btn btn-secondary" %>
      </div>
    <% end %>

    <% if @user.workspaces.any? %>
      <hr class="my-4">
      <div class="mb-3">
        <h5>Current Workspace Assignments</h5>
        <div class="table-responsive">
          <table class="table table-hover table-dark">
            <thead>
              <tr>
                <th>Workspace Name</th>
                <th>Building</th>
                <th>City</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @user.workspaces.each do |workspace| %>
                <tr>
                  <td><%= workspace.name %></td>
                  <td><%= workspace.building_name %></td>
                  <td><%= workspace.city %></td>
                  <td>
                    <%= button_to "Remove", 
                                assign_workspace_admin_user_path(@user, remove_workspace_id: workspace.id), 
                                method: :patch,
                                class: "btn btn-danger btn-sm",
                                data: { confirm: "Remove #{workspace.name} from this user?" } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      
      <div class="d-flex justify-content-between align-items-center">
        <h6>Bulk Actions</h6>
        <%= button_to "Remove All Workspace Assignments", 
                    assign_workspace_admin_user_path(@user), 
                    method: :patch,
                    class: "btn btn-danger btn-sm",
                    data: { confirm: "Are you sure you want to remove all workspace assignments for this user?" } %>
      </div>
    <% end %>
  </div>
</div>
