<nav aria-label="wizard-steps" class="mb-4 wizard-stepper-center">
  <ol class="breadcrumb bg-dark text-white p-2" style="border-radius: 0.5rem;">
    <li class="breadcrumb-item <%= step == 1 ? 'active text-white fw-bold' : 'text-white' %>" style="<%= step == 1 ? 'background: #222;' : '' %>">
      Step 1: Details
    </li>
    <li class="breadcrumb-item <%= step == 2 ? 'active text-white fw-bold' : (step > 2 ? 'text-white' : 'text-secondary') %>" style="<%= step == 2 ? 'background: #222;' : '' %>">
      Step 2: Assign User
    </li>
    <li class="breadcrumb-item <%= step == 3 ? 'active text-white fw-bold' : (step > 3 ? 'text-white' : 'text-secondary') %>" style="<%= step == 3 ? 'background: #222;' : '' %>">
      Step 3: Create Rooms
    </li>
  </ol>
</nav>
<style>
.breadcrumb-item.active {
  animation: fadeIn 0.7s;
}
@keyframes fadeIn {
  from { opacity: 0.3; }
  to { opacity: 1; }
}
.wizard-stepper-center {
  display: flex;
  justify-content: center;
}
</style>
