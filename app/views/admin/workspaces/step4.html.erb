<% content_for :page_title, "Create Company in Workspace" %>
<%= render 'wizard_stepper', step: 4 %>
<div class="row">
  <div class="col-lg-8 col-md-10 mx-auto">
    <div class="card bg-dark text-white shadow-sm p-4 mb-4" style="border-radius: 1rem;">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Step 4: Create Company</h2>
        <%= link_to "← Back", step3_admin_workspace_path(@workspace), class: "btn btn-outline-light border-white" %>
      </div>
      <%= render 'step4_company', workspace: @workspace, company: @company, available_users: @available_users %>
    </div>
  </div>
</div>
<style>
#wizard-step4-form input, #wizard-step4-form textarea {
  background: #111;
  color: #fff;
  border: 1px solid #444;
}
</style>
