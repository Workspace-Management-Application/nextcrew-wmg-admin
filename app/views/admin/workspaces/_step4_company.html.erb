<%= form_with url: update_step4_admin_workspace_path(@workspace), method: :patch, remote: true, html: { id: 'wizard-step4-form' } do |f| %>
  <div class="mb-3">
    <%= f.label :name, 'Company Name' %>
    <%= f.text_field :name, class: 'form-control' %>
  </div>
  <div class="mb-3">
    <%= f.label :email %>
    <%= f.email_field :email, class: 'form-control' %>
  </div>
  <div class="mb-3">
    <%= f.label :phone_number %>
    <%= f.text_field :phone_number, class: 'form-control' %>
  </div>
  <div class="mb-3">
    <%= f.label :address %>
    <%= f.text_area :address, class: 'form-control' %>
  </div>
  <div class="mb-3">
    <%= f.label :cabin_number %>
    <%= f.text_field :cabin_number, class: 'form-control' %>
  </div>
  <div class="mb-3">
    <%= f.label :no_of_employee %>
    <%= f.number_field :no_of_employee, class: 'form-control' %>
  </div>
  <div class="d-flex justify-content-end">
    <%= f.submit 'Finish', class: 'btn btn-success' %>
  </div>
<% end %>
