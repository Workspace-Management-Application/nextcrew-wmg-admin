<%= form_with model: @workspace, url: admin_workspaces_path, method: :post, remote: true, html: { id: 'wizard-step1-form' } do |f| %>
  <div class="mb-3">
    <%= f.label :name %>
    <%= f.text_field :name, class: 'form-control' %>
  </div>
  <div class="mb-3">
    <%= f.label :building_name %>
    <%= f.text_field :building_name, class: 'form-control' %>
  </div>
  <div class="mb-3">
    <%= f.label :address %>
    <%= f.text_area :address, class: 'form-control' %>
  </div>
  <div class="mb-3">
    <%= f.label :city %>
    <%= f.text_field :city, class: 'form-control' %>
  </div>
  <div class="mb-3">
    <%= f.label :pincode %>
    <%= f.text_field :pincode, class: 'form-control' %>
  </div>
  <div class="mb-3">
    <%= f.label :is_active %>
    <%= f.check_box :is_active %>
  </div>
  <div class="d-flex justify-content-end">
    <%= f.submit 'Save and Next', class: 'btn btn-primary' %>
  </div>
<% end %>
