<% content_for :page_title, "Workspaces" %>

<div class="content-area bg-dark text-white p-4 rounded">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Workspaces</h2>
    <%= link_to "Add Workspace", new_admin_workspace_path, class: "btn btn-primary" %>
  </div>

  <!-- Search Form -->
  <div class="row mb-4">
    <div class="col-md-8">
      <%= form_with url: admin_workspaces_path, method: :get, local: true, class: "d-flex" do |form| %>
        <%= form.text_field :search, placeholder: "Search by name, building, city, address, pincode...", 
                           value: params[:search], 
                           class: "form-control form-control-dark me-2" %>
        <%= form.submit "Search", class: "btn btn-outline-primary" %>
        <% if params[:search].present? || params[:filter].present? %>
          <%= link_to "Clear", admin_workspaces_path, class: "btn btn-outline-secondary ms-2" %>
        <% end %>
      <% end %>
    </div>
    <div class="col-md-4">
      <%= form_with url: admin_workspaces_path, method: :get, local: true, class: "d-flex" do |form| %>
        <%= form.hidden_field :search, value: params[:search] %>
        <%= form.select :filter, 
                       options_for_select([
                         ['All Status', ''],
                         ['Active', 'active'],
                         ['Inactive', 'inactive']
                       ], params[:filter]), 
                       {}, 
                       { class: "form-select form-control-dark me-2", onchange: "this.form.submit();" } %>
      <% end %>
    </div>
  </div>

  <!-- Results Info -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <%= pagination_info(@workspaces) %>
    </div>
    <div>
      <%= paginate @workspaces %>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover table-dark">
      <thead>
        <tr>
          <th>Name</th>
          <th>Building</th>
          <th>City</th>
          <th>Address</th>
          <th>Pincode</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @workspaces.each do |workspace| %>
          <tr class="clickable-row" data-href="<%= admin_workspace_path(workspace) %>" style="cursor: pointer;">
            <td><%= workspace.name %></td>
            <td><%= workspace.building_name %></td>
            <td><%= workspace.city %></td>
            <td><%= workspace.address %></td>
            <td><%= workspace.pincode %></td>
            <td class="action-column">
              <%= link_to "Edit", edit_admin_workspace_path(workspace), class: "btn btn-secondary btn-sm me-2" %>
              <%= link_to "Delete", admin_workspace_path(workspace), 
                          data: { 
                            turbo_method: :delete, 
                            turbo_confirm: "Are you sure you want to delete this workspace?" 
                          },
                          class: "btn btn-danger btn-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @workspaces.empty? %>
    <div class="text-center mt-5">
      <p class="text-muted">No workspaces found.</p>
      <%= link_to "Add your first workspace", new_admin_workspace_path, class: "btn btn-primary" %>
    </div>
  <% else %>
    <!-- Bottom Pagination -->
    <div class="d-flex justify-content-between align-items-center mt-4">
      <div>
        <%= pagination_info(@workspaces) %>
      </div>
      <div>
        <%= paginate @workspaces %>
      </div>
    </div>
  <% end %>
</div>
