<% content_for :page_title, "Edit Profile" %>

<div class="row">
  <div class="col-lg-8 col-md-10 mx-auto">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Edit Profile</h2>
      <%= link_to "← Back to Profile", admin_profile_path, class: "btn btn-outline-primary" %>
    </div>

    <%# Basic Information Form %>
    <%= form_with model: [:admin, @user], url: admin_profile_path, local: true, data: { turbo: false }, class: "needs-validation mb-4", novalidate: true do |form| %>
      <% if @user.errors.any? %>
        <% profile_errors = @user.errors.reject { |attr, _| [:password, :password_confirmation].include?(attr) } %>
        <% if profile_errors.any? %>
          <div class="alert alert-danger">
            <h6><%= pluralize(profile_errors.count, "error") %> prohibited the profile from being updated:</h6>
            <ul class="mb-0">
              <% profile_errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      <% end %>

      <div class="bg-dark p-4 rounded">
        <h5 class="mb-3">Basic Information</h5>
        <div class="row">
          <div class="col-md-6 mb-3">
            <%= form.label :name, class: "form-label" %>
            <%= form.text_field :name, class: "form-control", required: true %>
          </div>
          
          <div class="col-md-6 mb-3">
            <%= form.label :email, class: "form-label" %>
            <%= form.email_field :email, class: "form-control", required: true %>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <%= form.label :phone_number, class: "form-label" %>
            <%= form.telephone_field :phone_number, class: "form-control" %>
          </div>
        </div>
      </div>

      <div class="d-flex gap-2 mt-3">
        <%= form.submit "Update Profile Info", class: "btn btn-primary" %>
        <%= link_to "Cancel", admin_profile_path, class: "btn btn-secondary" %>
      </div>
    <% end %>

    <%# Password Change Form %>
    <%= form_with model: [:admin, @user], url: admin_profile_path, local: true, data: { turbo: false }, class: "needs-validation" do |form| %>
      <% if @user.errors.any? %>
        <% password_errors = @user.errors.select { |attr, _| [:password, :password_confirmation].include?(attr) } %>
        <% if password_errors.any? %>
          <div class="alert alert-danger">
            <h6>Password update errors:</h6>
            <ul class="mb-0">
              <% password_errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      <% end %>

      <div class="bg-dark p-4 rounded">
        <h5 class="mb-3">Change Password</h5>
        <div class="row">
          <div class="col-md-6 mb-3">
            <%= form.label :password, "New Password", class: "form-label" %>
            <%= form.password_field :password, class: "form-control" %>
          </div>
          
          <div class="col-md-6 mb-3">
            <%= form.label :password_confirmation, "Confirm New Password", class: "form-label" %>
            <%= form.password_field :password_confirmation, class: "form-control" %>
          </div>
        </div>
      </div>

      <div class="d-flex gap-2 mt-3">
        <%= form.submit "Update Password", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
