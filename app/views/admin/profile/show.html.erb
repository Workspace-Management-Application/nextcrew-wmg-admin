<% content_for :page_title, "Profile" %>

<div class="row">
  <div class="col-lg-8 col-md-10 mx-auto">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>My Profile</h2>
      <%= link_to "Edit Profile", edit_admin_profile_path, class: "btn btn-primary" %>
    </div>

    <div class="bg-dark p-4 rounded">
      <div class="row">
        <div class="col-md-8">
          <h4 class="mb-3">Profile Information</h4>
          <div class="row">
            <div class="col-md-6">
              <p><strong>Name:</strong> <%= @user.name %></p>
              <p><strong>Email:</strong> <%= @user.email %></p>
            </div>
            <div class="col-md-6">
              <p><strong>Phone:</strong> <%= @user.phone || 'Not provided' %></p>
              <p><strong>Role:</strong> 
                <span class="badge <%= @user.role == 'super_admin' ? 'bg-light text-dark' : @user.role == 'admin' ? 'bg-secondary' : 'bg-dark' %>">
                  <%= @user.role.humanize %>
                </span>
              </p>
              <% if @user.workspace %>
                <p><strong>Assigned Workspace:</strong> <%= @user.workspace.name %></p>
              <% end %>
            </div>
          </div>
        </div>
        
        <div class="col-md-4 text-center">        <div class="profile-avatar mx-auto" style="width: 80px; height: 80px; font-size: 2rem;">
          <%= @user.name&.first&.upcase || "A" %>
        </div>
          <p class="mt-2 text-muted">Profile Avatar</p>
        </div>
      </div>
    </div>
  </div>
</div>
