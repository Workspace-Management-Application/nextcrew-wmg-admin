<% content_for :page_title, "Workspace Types" %>

<div class="content-area bg-dark text-white p-4 rounded">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Manage Workspace Types</h2>
  </div>

  <!-- Collapsible Add Form -->
  <div class="card bg-dark border-secondary mb-4">
    <div class="card-header bg-secondary" id="addWorkspaceTypeHeader">
      <h5 class="mb-0">
        <button class="btn btn-link text-white text-decoration-none" type="button" 
                data-bs-toggle="collapse" data-bs-target="#addWorkspaceTypeForm" 
                aria-expanded="false" aria-controls="addWorkspaceTypeForm">
          <i class="fas fa-plus me-2"></i>Add New Workspace Type
        </button>
      </h5>
    </div>
    
    <div id="addWorkspaceTypeForm" class="collapse" aria-labelledby="addWorkspaceTypeHeader">
      <div class="card-body">
        <%= form_with model: [:admin, @workspace_type], local: true, data: { turbo: false }, class: "needs-validation", novalidate: true do |form| %>
          <% if @workspace_type.errors.any? %>
            <div class="alert alert-danger">
              <h6><%= pluralize(@workspace_type.errors.count, "error") %> prohibited this workspace type from being saved:</h6>
              <ul class="mb-0">
                <% @workspace_type.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="row">
            <div class="col-md-8">
              <%= form.label :name, "Workspace Type Name", class: "form-label" %>
              <%= form.text_field :name, class: "form-control", required: true, placeholder: "e.g., Private Cabin, Shared Desk" %>
            </div>
            <div class="col-md-4 d-flex align-items-end">
              <%= form.submit "Add Workspace Type", class: "btn btn-primary" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Workspace Types Listing -->
  <div class="card bg-dark border-secondary">
    <div class="card-header bg-secondary">
      <h5 class="mb-0">Workspace Types List</h5>
    </div>
    <div class="card-body">
      <% if @workspace_types.any? %>
        <div class="table-responsive">
          <table class="table table-hover table-dark">
            <thead>
              <tr>
                <th>Name</th>
                <th>Associated Workspaces</th>
                <th>Created</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @workspace_types.each do |workspace_type| %>
                <tr>
                  <td>
                    <strong><%= workspace_type.name %></strong>
                    <% if WorkspaceType::DEFAULT_TYPES.include?(workspace_type.name) %>
                      <span class="badge bg-info ms-2">Default</span>
                    <% end %>
                  </td>
                  <td>
                    <% if workspace_type.workspaces.any? %>
                      <span class="badge bg-success"><%= workspace_type.workspaces.count %> workspace(s)</span>
                    <% else %>
                      <span class="text-muted">No workspaces</span>
                    <% end %>
                  </td>
                  <td><%= workspace_type.created_at.strftime("%b %d, %Y") %></td>
                  <td>
                    <% unless WorkspaceType::DEFAULT_TYPES.include?(workspace_type.name) %>
                      <%= link_to "Edit", edit_admin_workspace_type_path(workspace_type), class: "btn btn-secondary btn-sm me-2" %>
                      <%= link_to "Delete", admin_workspace_type_path(workspace_type), 
                                  data: { 
                                    turbo_method: :delete, 
                                    turbo_confirm: "Are you sure you want to delete this workspace type?" 
                                  },
                                  class: "btn btn-danger btn-sm" %>
                    <% else %>
                      <span class="text-muted">Default type - cannot be modified</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-4">
          <p class="text-muted">No workspace types found.</p>
        </div>
      <% end %>
    </div>
  </div>
</div> 