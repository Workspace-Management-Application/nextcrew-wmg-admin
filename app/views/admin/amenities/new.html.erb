<% content_for :page_title, "Add Amenity" %>

<div class="row">
  <div class="col-lg-8 col-md-10 mx-auto">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Add New Amenity</h2>
      <%= link_to "← Back to Amenities", admin_amenities_path, class: "btn btn-outline-primary" %>
    </div>

    <%= form_with model: [:admin, @amenity], local: true, data: { turbo: false }, class: "needs-validation", novalidate: true do |form| %>
      <% if @amenity.errors.any? %>
        <div class="alert alert-danger">
          <h6><%= pluralize(@amenity.errors.count, "error") %> prohibited this amenity from being saved:</h6>
          <ul class="mb-0">
            <% @amenity.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= form.label :name, class: "form-label" %>
        <%= form.text_field :name, class: "form-control", required: true, placeholder: "e.g., Whiteboard, Projector, TV" %>
      </div>

      <div class="d-flex gap-2">
        <%= form.submit "Create Amenity", class: "btn btn-primary" %>
        <%= link_to "Cancel", admin_amenities_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
