<% content_for :page_title, "Dashboard" %>

<div class="dashboard-container">
  <!-- Metrics Row -->
  <div class="row g-3 mb-4">
    <div class="col-lg-3 col-md-6">
      <div class="metric-card">
        <div class="metric-label">Total Workspaces</div>
        <div class="metric-value"><%= @total_workspaces %></div>
      </div>
    </div>
    <div class="col-lg-3 col-md-6">
      <div class="metric-card">
        <div class="metric-label">Total Rooms</div>
        <div class="metric-value"><%= @total_rooms %></div>
      </div>
    </div>
    <div class="col-lg-3 col-md-6">
      <div class="metric-card">
        <div class="metric-label">Today's Bookings</div>
        <div class="metric-value"><%= @todays_bookings %></div>
      </div>
    </div>
    <div class="col-lg-3 col-md-6">
      <div class="metric-card">
        <div class="metric-label">Day Passes Generated Today</div>
        <div class="metric-value"><%= @day_passes_today %></div>
      </div>
    </div>
  </div>

  <!-- Chart Section -->
  <div class="row">
    <div class="col-12">
      <div class="chart-container">
        <h4>7-Day Booking Trends</h4>
        <div style="position: relative; height: 200px;">
          <canvas id="bookingChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="quick-actions">
    <%= link_to new_admin_workspace_path, class: "quick-action-btn" do %>
      <div>+ Add Workspace</div>
    <% end %>
    
    <%= link_to new_admin_booking_path, class: "quick-action-btn" do %>
      <div>+ Add Booking</div>
    <% end %>
    
    <%= link_to new_admin_company_path, class: "quick-action-btn" do %>
      <div>+ Add Company</div>
    <% end %>
    
    <%= link_to new_admin_user_path, class: "quick-action-btn" do %>
      <div>+ Add User</div>
    <% end %>
  </div>
</div>

<% content_for :scripts do %>
<script>
  // Chart data from server - use window object to avoid redeclaration issues
  if (typeof window.dashboardChartData === 'undefined') {
    window.dashboardChartData = <%= raw @booking_chart_data.to_json %>;
  }
  
  // Use window object for chart instance to avoid redeclaration issues
  if (typeof window.bookingChart === 'undefined') {
    window.bookingChart = null;
  }

  function initializeBookingChart() {
    const canvas = document.getElementById('bookingChart');
    if (!canvas) return;

    // Check if Chart.js is available
    if (typeof Chart === 'undefined') {
      console.warn('Chart.js not loaded yet, retrying in 100ms...');
      setTimeout(initializeBookingChart, 100);
      return;
    }

    // Destroy existing chart if it exists
    if (window.bookingChart && typeof window.bookingChart.destroy === 'function') {
      try {
        window.bookingChart.destroy();
      } catch (error) {
        console.warn('Error destroying existing chart:', error);
      }
    }

    const ctx = canvas.getContext('2d');
    
    window.bookingChart = new Chart(ctx, {
    type: 'bar',
    data: {
        labels: window.dashboardChartData.map(item => item.date),
      datasets: [{
        label: 'Bookings',
          data: window.dashboardChartData.map(item => item.bookings),
        backgroundColor: '#ffffff',
        borderColor: '#ffffff',
        borderWidth: 1,
        borderRadius: 4,
        borderSkipped: false,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        }
      },
      layout: {
        padding: {
          top: 10,
          bottom: 10
        }
      },
      scales: {
        y: {
          beginAtZero: true,
            max: Math.max(...window.dashboardChartData.map(item => item.bookings)) + 5, // Add some padding to max value
          ticks: {
            color: '#cccccc',
            font: {
              size: 11
            },
            stepSize: 2
          },
          grid: {
            color: '#333333',
            drawBorder: false
          }
        },
        x: {
          ticks: {
            color: '#cccccc',
            font: {
              size: 11
            }
          },
          grid: {
            display: false
          }
        }
      },
      elements: {
        bar: {
          backgroundColor: '#ffffff'
        }
      }
    }
  });
  }

  // Initialize chart on page load
  document.addEventListener('DOMContentLoaded', initializeBookingChart);
  
  // Re-initialize chart after Turbo navigation
  document.addEventListener('turbo:load', initializeBookingChart);
  
  // Also initialize immediately if DOM is already loaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeBookingChart);
  } else {
    initializeBookingChart();
  }
</script>
<% end %>
