<% content_for :page_title, "Visitor Entry Details" %>

<div class="content-area bg-dark text-white p-4 rounded">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Visitor Entry Details</h2>
    <div>
      <%= link_to "Edit", edit_admin_visitor_entry_path(@visitor_entry), class: "btn btn-secondary me-2" %>
      <%= link_to "Delete", admin_visitor_entry_path(@visitor_entry),
                  data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this visitor entry?" },
                  class: "btn btn-danger" %>
      <%= link_to "Back", admin_visitor_entries_path, class: "btn btn-outline-light ms-2" %>
    </div>
  </div>

  <div class="row mb-3">
    <div class="col-md-6 mb-3">
      <strong>Visitor Name:</strong>
      <div><%= @visitor_entry.name %></div>
    </div>
    <div class="col-md-6 mb-3">
      <strong>Email:</strong>
      <div><%= @visitor_entry.email %></div>
    </div>
    <div class="col-md-6 mb-3">
      <strong>Phone Number:</strong>
      <div><%= @visitor_entry.phone_number %></div>
    </div>
    <div class="col-md-6 mb-3">
      <strong>Person to Visit:</strong>
      <div><%= @visitor_entry.person_to_visit_name %></div>
    </div>
    <div class="col-md-6 mb-3">
      <strong>Workspace:</strong>
      <div><%= @visitor_entry.workspace&.name %></div>
    </div>
    <div class="col-md-6 mb-3">
      <strong>Date:</strong>
      <div><%= @visitor_entry.created_at.strftime("%B %d, %Y") %></div>
    </div>
    <div class="col-12 mb-3">
      <strong>Purpose:</strong>
      <div><%= @visitor_entry.purpose %></div>
    </div>
    <% if @visitor_entry.photo.attached? %>
      <div class="col-12 mb-3">
        <strong>Photo:</strong><br>
        <%= image_tag @visitor_entry.photo, class: "img-thumbnail mt-2", style: "max-width: 200px;" %>
      </div>
    <% end %>
  </div>
</div> 