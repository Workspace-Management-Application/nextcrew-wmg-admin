<%= form_with(model: [:admin, @visitor_entry], local: true, data: { turbo: false }, html: { class: "row g-3" }) do |form| %>
  <div class="col-md-6">
    <%= form.label :name, class: "form-label" %><span class="text-danger">*</span>
    <%= form.text_field :name, class: "form-control form-control-dark" %>
  </div>
  <div class="col-md-6">
    <%= form.label :email, class: "form-label" %><span class="text-danger">*</span>
    <%= form.email_field :email, class: "form-control form-control-dark" %>
  </div>
  <div class="col-md-6">
    <%= form.label :phone_number, class: "form-label" %><span class="text-danger">*</span>
    <%= form.text_field :phone_number, class: "form-control form-control-dark" %>
  </div>
  <div class="col-md-6">
    <%= form.label :person_to_visit_name, "Person to Visit", class: "form-label" %><span class="text-danger">*</span>
    <%= form.text_field :person_to_visit_name, class: "form-control form-control-dark" %>
  </div>
  <div class="col-md-12">
    <%= form.label :purpose, class: "form-label" %><span class="text-danger">*</span>
    <%= form.text_area :purpose, class: "form-control form-control-dark", rows: 2 %>
  </div>
  <div class="col-md-6">
    <%= form.label :workspace_id, "Workspace", class: "form-label" %><span class="text-danger">*</span>
    <%= form.collection_select :workspace_id, @workspaces, :id, :name, { prompt: "Select Workspace" }, { class: "form-select form-control-dark" } %>
  </div>
  <div class="col-md-6">
    <%= form.label :photo, class: "form-label" %><span class="text-danger">*</span>
    <%= form.file_field :photo, class: "form-control form-control-dark" %>
  </div>
  <div class="col-12 mt-3">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_visitor_entries_path, class: "btn btn-secondary ms-2" %>
  </div>
<% end %> 