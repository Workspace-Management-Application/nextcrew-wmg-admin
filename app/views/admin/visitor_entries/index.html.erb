<% content_for :page_title, "Visitor Entries" %>

<div class="content-area bg-dark text-white p-4 rounded">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Visitor Entries</h2>
    <%= link_to "Add Visitor Entry", new_admin_visitor_entry_path, class: "btn btn-primary" %>
  </div>

  <!-- Search and Filter Form -->
  <div class="bg-dark p-3 rounded mb-4">
    <%= form_with url: admin_visitor_entries_path, method: :get, local: true, class: "row g-3" do |form| %>
      <div class="col-md-4">
        <%= form.label :search, "Search", class: "form-label" %>
        <%= form.text_field :search, placeholder: "Search by name, email, person to visit, purpose...", 
                           value: params[:search], 
                           class: "form-control form-control-dark" %>
      </div>
      <div class="col-md-2">
        <%= form.label :workspace_id, "Workspace", class: "form-label" %>
        <%= form.select :workspace_id, 
                        options_from_collection_for_select(@workspaces, :id, :name, params[:workspace_id]), 
                        { prompt: 'All Workspaces' }, 
                        { class: "form-select form-control-dark" } %>
      </div>
      <div class="col-md-2">
        <%= form.label :date_from, "From Date", class: "form-label" %>
        <%= form.date_field :date_from, value: params[:date_from], class: "form-control form-control-dark" %>
      </div>
      <div class="col-md-2">
        <%= form.label :date_to, "To Date", class: "form-label" %>
        <%= form.date_field :date_to, value: params[:date_to], class: "form-control form-control-dark" %>
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <%= form.submit "Search/Filter", class: "btn btn-outline-primary me-2" %>
        <%= link_to "Clear", admin_visitor_entries_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>

  <!-- Results Info -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <%= pagination_info(@visitor_entries) %>
    </div>
    <div>
      <%= paginate @visitor_entries %>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover table-dark">
      <thead>
        <tr>
          <th>Visitor Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Person to Visit</th>
          <th>Purpose</th>
          <th>Workspace</th>
          <th>Date</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @visitor_entries.each do |entry| %>
          <tr class="clickable-row" data-href="<%= admin_visitor_entry_path(entry) %>" style="cursor: pointer;">
            <td><%= entry.name %></td>
            <td><%= entry.email %></td>
            <td><%= entry.phone_number %></td>
            <td><%= entry.person_to_visit_name %></td>
            <td>
              <span class="text-truncate d-inline-block" style="max-width: 200px;" title="<%= entry.purpose %>">
                <%= entry.purpose %>
              </span>
            </td>
            <td><%= entry.workspace.name %></td>
            <td><%= entry.created_at.strftime("%b %d, %Y") %></td>
            <td class="action-column">
              <%= link_to "Edit", edit_admin_visitor_entry_path(entry), class: "btn btn-secondary btn-sm me-2" %>
              <%= link_to "Delete", admin_visitor_entry_path(entry), 
                          data: { 
                            turbo_method: :delete, 
                            turbo_confirm: "Are you sure you want to delete this visitor entry?" 
                          },
                          class: "btn btn-danger btn-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @visitor_entries.empty? %>
    <div class="text-center mt-5">
      <% if params[:search].present? || params[:workspace_id].present? || params[:date_from].present? || params[:date_to].present? %>
        <p class="text-muted">No visitor entries found matching your search criteria.</p>
        <%= link_to "Clear filters", admin_visitor_entries_path, class: "btn btn-outline-secondary" %>
      <% else %>
        <p class="text-muted">No visitor entries found.</p>
        <%= link_to "Add the first visitor entry", new_admin_visitor_entry_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  <% else %>
    <!-- Bottom Pagination -->
    <div class="d-flex justify-content-between align-items-center mt-4">
      <div>
        <%= pagination_info(@visitor_entries) %>
      </div>
      <div>
        <%= paginate @visitor_entries %>
      </div>
    </div>
  <% end %>
</div> 