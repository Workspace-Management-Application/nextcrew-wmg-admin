<% content_for :page_title, "Edit Room - #{@room.name}" %>

<div class="row">
  <div class="col-lg-8 col-md-10 mx-auto">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Edit Room</h2>
      <%= link_to "← Back to Rooms", admin_rooms_path, class: "btn btn-outline-primary" %>
    </div>

    <%= form_with model: [:admin, @workspace, @room], local: true, class: "needs-validation", novalidate: true do |form| %>
      <% if @room.errors.any? %>
        <div class="alert alert-danger">
          <h6><%= pluralize(@room.errors.count, "error") %> prohibited this room from being saved:</h6>
          <ul class="mb-0">
            <% @room.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= form.label :name, class: "form-label" %>
          <%= form.text_field :name, class: "form-control", required: true, placeholder: "e.g., Conference Room A" %>
        </div>
        
        <div class="col-md-6 mb-3">
          <%= form.label :category, class: "form-label" %>
          <%= form.select :category, 
                          options_for_select([
                            ['Meeting Room', 'meeting_room'],
                            ['Conference Room', 'conference_room'],
                            ['Phone Booth', 'phone_booth'],
                            ['Open Desk', 'open_desk'],
                            ['Private Office', 'private_office'],
                            ['Event Space', 'event_space']
                          ], @room.category), 
                          { prompt: 'Select Category' }, 
                          { class: "form-select", required: true } %>
        </div>
      </div>

      <div class="mb-3">
        <%= form.label :capacity, class: "form-label" %>
        <%= form.number_field :capacity, class: "form-control", required: true, min: 1, placeholder: "Maximum number of people" %>
      </div>

      <div class="mb-3">
        <%= form.label :photo, "Room Photo", class: "form-label" %>
        <% if @room.photo.attached? %>
          <div class="current-photo mb-2">
            <small class="text-muted">Current photo:</small><br>
            <%= image_tag @room.photo, class: "img-thumbnail", style: "max-width: 200px; height: auto;" %>
          </div>
        <% end %>
        <%= form.file_field :photo, class: "form-control", accept: "image/*" %>
        <div class="form-text">Upload a new photo to replace the current one (optional). Supported formats: JPG, PNG, GIF, WebP. Max size: 5MB.</div>
      </div>

      <div class="row mb-3">
        <div class="col-md-3">
          <%= form.label :whiteboard, "Whiteboard", class: "form-label" %>
          <div>
            <div class="form-check form-check-inline">
              <%= form.radio_button :whiteboard, true, class: "form-check-input", id: "whiteboard_yes" %>
              <%= form.label :whiteboard_yes, "Yes", class: "form-check-label" %>
            </div>
            <div class="form-check form-check-inline">
              <%= form.radio_button :whiteboard, false, class: "form-check-input", id: "whiteboard_no" %>
              <%= form.label :whiteboard_no, "No", class: "form-check-label" %>
            </div>
          </div>
        </div>
        
        <div class="col-md-3">
          <%= form.label :projector, "Projector", class: "form-label" %>
          <div>
            <div class="form-check form-check-inline">
              <%= form.radio_button :projector, true, class: "form-check-input", id: "projector_yes" %>
              <%= form.label :projector_yes, "Yes", class: "form-check-label" %>
            </div>
            <div class="form-check form-check-inline">
              <%= form.radio_button :projector, false, class: "form-check-input", id: "projector_no" %>
              <%= form.label :projector_no, "No", class: "form-check-label" %>
            </div>
          </div>
        </div>
        
        <div class="col-md-3">
          <%= form.label :tv, "TV", class: "form-label" %>
          <div>
            <div class="form-check form-check-inline">
              <%= form.radio_button :tv, true, class: "form-check-input", id: "tv_yes" %>
              <%= form.label :tv_yes, "Yes", class: "form-check-label" %>
            </div>
            <div class="form-check form-check-inline">
              <%= form.radio_button :tv, false, class: "form-check-input", id: "tv_no" %>
              <%= form.label :tv_no, "No", class: "form-check-label" %>
            </div>
          </div>
        </div>
        
        <div class="col-md-3">
          <%= form.label :is_available, "Active", class: "form-label" %>
          <div>
            <div class="form-check form-check-inline">
              <%= form.radio_button :is_available, true, class: "form-check-input", id: "is_available_yes" %>
              <%= form.label :is_available_yes, "Yes", class: "form-check-label" %>
            </div>
            <div class="form-check form-check-inline">
              <%= form.radio_button :is_available, false, class: "form-check-input", id: "is_available_no" %>
              <%= form.label :is_available_no, "No", class: "form-check-label" %>
            </div>
          </div>
        </div>
      </div>

      <div class="d-flex gap-2">
        <%= form.submit "Update Room", class: "btn btn-primary" %>
        <%= link_to "Cancel", admin_rooms_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
