<% content_for :page_title, "Room - #{@room.name}" %>

<div class="row">
  <div class="col-lg-8 col-md-10 mx-auto">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2><%= @room.name %></h2>
      <div>
        <%= link_to "Edit", edit_admin_workspace_room_path(@workspace, @room), class: "btn btn-primary me-2" %>
        <%= link_to "← Back to Rooms", admin_workspace_rooms_path(@workspace), class: "btn btn-outline-primary" %>
      </div>
    </div>

    <div class="card">
      <div class="card-body">
        <% if @room.photo.attached? %>
          <div class="row mb-4">
            <div class="col-12">
              <strong>Room Photo:</strong>
              <div class="mt-2">
                <%= image_tag @room.photo, class: "img-fluid rounded", style: "max-width: 100%; height: auto; max-height: 400px;" %>
              </div>
            </div>
          </div>
        <% end %>

        <div class="row mb-3">
          <div class="col-sm-3">
            <strong>Room Name:</strong>
          </div>
          <div class="col-sm-9">
            <%= @room.name %>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-sm-3">
            <strong>Category:</strong>
          </div>
          <div class="col-sm-9">
            <%= @room.category.humanize %>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-sm-3">
            <strong>Capacity:</strong>
          </div>
          <div class="col-sm-9">
            <%= @room.capacity %> people
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-sm-3">
            <strong>Whiteboard:</strong>
          </div>
          <div class="col-sm-9">
            <% if @room.whiteboard %>
              <span class="badge bg-success">Available</span>
            <% else %>
              <span class="badge bg-secondary">Not Available</span>
            <% end %>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-sm-3">
            <strong>Projector:</strong>
          </div>
          <div class="col-sm-9">
            <% if @room.projector %>
              <span class="badge bg-success">Available</span>
            <% else %>
              <span class="badge bg-secondary">Not Available</span>
            <% end %>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-sm-3">
            <strong>Status:</strong>
          </div>
          <div class="col-sm-9">
            <% if @room.is_available %>
              <span class="badge bg-success">Active</span>
            <% else %>
              <span class="badge bg-danger">Inactive</span>
            <% end %>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-sm-3">
            <strong>Currently:</strong>
          </div>
          <div class="col-sm-9">
            <% if @room.is_occupied? %>
              <span class="badge bg-warning">Occupied</span>
            <% else %>
              <span class="badge bg-success">Available</span>
            <% end %>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-sm-3">
            <strong>Workspace:</strong>
          </div>
          <div class="col-sm-9">
            <%= link_to @workspace.name, admin_workspace_path(@workspace), class: "text-decoration-none" %>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-4">
      <div class="d-flex gap-2">
        <%= link_to "Edit Room", edit_admin_workspace_room_path(@workspace, @room), class: "btn btn-primary" %>
        <%= link_to "Delete Room", admin_workspace_room_path(@workspace, @room), 
                    data: { 
                      turbo_method: :delete, 
                      turbo_confirm: "Are you sure you want to delete this room? This action cannot be undone." 
                    },
                    class: "btn btn-danger" %>
        <%= link_to "Back to Rooms", admin_workspace_rooms_path(@workspace), class: "btn btn-secondary" %>
      </div>
    </div>
  </div>
</div>
