<% content_for :page_title, "All Rooms" %>

<div class="content-area bg-dark text-white p-4 rounded">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Rooms</h2>
    <%= link_to "Add Room", new_admin_room_path, class: "btn btn-primary" %>
  </div>

  <!-- Search Form -->
  <div class="row mb-4">
    <div class="col-md-4">
      <label class="form-label">Search Rooms</label>
      <%= form_with url: admin_rooms_path, method: :get, local: true, class: "d-flex" do |form| %>
        <%= form.hidden_field :filter, value: params[:filter] if params[:filter].present? %>
        <%= form.hidden_field :availability, value: params[:availability] if params[:availability].present? %>
        <%= form.hidden_field :workspace_id, value: params[:workspace_id] if params[:workspace_id].present? %>
        <%= form.text_field :search, placeholder: "Search by room name, category, or workspace...", 
                           value: params[:search], 
                           class: "form-control form-control-dark me-2" %>
        <%= form.submit "Search", class: "btn btn-outline-primary" %>
        <% if params[:search].present? || params[:filter].present? || params[:workspace_id].present? %>
          <%= link_to "Clear", admin_rooms_path, class: "btn btn-outline-secondary ms-2" %>
        <% end %>
      <% end %>
    </div>
    <div class="col-md-3">
      <label class="form-label">Filter by Category</label>
      <%= form_with url: admin_rooms_path, method: :get, local: true, class: "d-flex" do |form| %>
        <%= form.hidden_field :search, value: params[:search] if params[:search].present? %>
        <%= form.hidden_field :availability, value: params[:availability] if params[:availability].present? %>
        <%= form.hidden_field :workspace_id, value: params[:workspace_id] if params[:workspace_id].present? %>
        <%= form.select :filter, 
                       options_for_select([
                         ['All Categories', ''],
                         ['Meeting Room', 'meeting_room'],
                         ['Conference Room', 'conference_room'],
                         ['Private Office', 'private_office'],
                         ['Hot Desk', 'hot_desk']
                       ], params[:filter]), 
                       {}, 
                       { class: "form-select form-control-dark me-2", onchange: "this.form.submit();" } %>
      <% end %>
    </div>
    <div class="col-md-2">
      <label class="form-label">Filter by Status</label>
      <%= form_with url: admin_rooms_path, method: :get, local: true, class: "d-flex" do |form| %>
        <%= form.hidden_field :search, value: params[:search] if params[:search].present? %>
        <%= form.hidden_field :filter, value: params[:filter] if params[:filter].present? %>
        <%= form.hidden_field :workspace_id, value: params[:workspace_id] if params[:workspace_id].present? %>
        <%= form.select :availability, 
                       options_for_select([
                         ['All Status', ''],
                         ['Available', 'available'],
                         ['Unavailable', 'unavailable']
                       ], params[:availability]), 
                       {}, 
                       { class: "form-select form-control-dark", onchange: "this.form.submit();" } %>
      <% end %>
    </div>
    <div class="col-md-3">
      <label class="form-label">Filter by Workspace</label>
      <%= form_with url: admin_rooms_path, method: :get, local: true, class: "d-flex" do |form| %>
        <%= form.hidden_field :search, value: params[:search] if params[:search].present? %>
        <%= form.hidden_field :filter, value: params[:filter] if params[:filter].present? %>
        <%= form.hidden_field :availability, value: params[:availability] if params[:availability].present? %>
        <%= form.select :workspace_id, 
                       options_from_collection_for_select(current_user.workspaces, :id, :name, params[:workspace_id].to_i), 
                       { prompt: 'All Workspaces' }, 
                       { class: "form-select form-control-dark", onchange: "this.form.submit();" } %>
      <% end %>
    </div>
  </div>

  <!-- Results Info -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <%= pagination_info(@rooms) %>
    </div>
    <div>
      <%= paginate @rooms %>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover table-dark datatable">
      <thead>
        <tr>
          <th>Name</th>
          <th>Workspace</th>
          <th>Category</th>
          <th>Capacity</th>
          <th>Amenities</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @rooms.each do |room| %>
          <tr class="clickable-row" data-href="<%= admin_room_path(room) %>" style="cursor: pointer;">
            <td><%= room.name %></td>
            <td><%= room.workspace.name %></td>
            <td><%= room.category.humanize %></td>
            <td><%= room.capacity %> people</td>
            <td>
              <% if room.amenities.any? %>
                <div class="d-flex flex-wrap gap-1">
                  <% room.amenities.each do |amenity| %>
                    <span class="badge bg-warning"><%= amenity.name %></span>
                  <% end %>
                </div>
              <% else %>
                <span class="text-muted">None</span>
              <% end %>
            </td>
            <td>
              <% if room.is_available %>
                <span class="badge bg-success">Active</span>
              <% else %>
                <span class="badge bg-danger">Inactive</span>
              <% end %>
            </td>
            <td class="action-column">
              <%= link_to "Edit", edit_admin_workspace_room_path(room.workspace, room), class: "btn btn-secondary btn-sm me-2" %>
              <%= link_to "Delete", admin_workspace_room_path(room.workspace, room), 
                          data: { 
                            turbo_method: :delete, 
                            turbo_confirm: "Are you sure you want to delete this room?" 
                          },
                          class: "btn btn-danger btn-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @rooms.empty? %>
    <div class="text-center mt-5">
      <% if params[:search].present? || params[:filter].present? || params[:workspace_id].present? %>
        <p class="text-muted">No rooms found matching your search criteria.</p>
        <%= link_to "Clear filters", admin_rooms_path, class: "btn btn-outline-secondary" %>
      <% else %>
        <p class="text-muted">No rooms found in your workspaces.</p>
        <%= link_to "Go to Workspaces", admin_workspaces_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  <% else %>
    <!-- Bottom Pagination -->
    <div class="d-flex justify-content-between align-items-center mt-4">
      <div>
        <%= pagination_info(@rooms) %>
      </div>
      <div>
        <%= paginate @rooms %>
      </div>
    </div>
  <% end %>
</div>

<script>
    intializeDataTableSort();
</script>

